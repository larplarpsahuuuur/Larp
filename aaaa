function Window:_queueSave()
    if self._loading then return end
    self._saveToken = (self._saveToken or 0) + 1
    local my = self._saveToken
    task.delay(1, function()
        if self._saveToken == my and self.Alive then self:SaveConfig(self.ConfigFile) end
    end)
end
function Window:SaveConfig(name)
    name = tostring(name or "default")
    local data = {}
    for flag, e in pairs(self.Flags) do
        if e.Value ~= nil and e.Type ~= "Button" and e.Type ~= "Label" and e.Type ~= "Paragraph" then data[flag] = encode(e.Value) end
    end
    return writeJson(self.Folder .. "/configs/" .. name .. ".json", data)
end
function Window:LoadConfig(name)
    local data = readJson(self.Folder .. "/configs/" .. tostring(name or "default") .. ".json")
    if type(data) ~= "table" then return false end
    self._loading = true
    for flag, v in pairs(data) do
        local e = self.Flags[flag]
        if e and e.Set then pcall(e.Set, e, decode(v)) end
    end
    self._loading = false
    return true
end
function Window:DeleteConfig(name)
    if type(delfile) ~= "function" then return false end
    return pcall(delfile, self.Folder .. "/configs/" .. tostring(name) .. ".json")
end
function Window:ListConfigs()
    local out = {}
    if type(listfiles) ~= "function" or type(isfolder) ~= "function" then return out end
    local dir = self.Folder .. "/configs"
    if not isfolder(dir) then return out end
    local ok, files = pcall(listfiles, dir)
    if not ok then return out end
    for _, p in ipairs(files) do
        local n = tostring(p):match("([^/\\]+)%.json$")
        if n and n ~= self.ConfigFile then out[#out + 1] = n end
    end
    table.sort(out)
    return out
end
function Window:SetAutoload(name)
    if not canFile() then return end
    ensureFolder(self.Folder)
    if name then pcall(writefile, self.Folder .. "/autoload.txt", tostring(name))
    elseif type(delfile) == "function" then pcall(delfile, self.Folder .. "/autoload.txt") end
end
function Window:GetAutoload()
    if not canFile() then return nil end
    local ok, s = pcall(function()
        local p = self.Folder .. "/autoload.txt"
        if isfile(p) then return readfile(p) end
    end)
    return ok and s ~= "" and s or nil
end
-- 保存してある値を読み込む (要素を全部作った後、最後に呼ぶ)
function Window:LoadConfiguration()
    local auto = self:GetAutoload()
    if auto then self:LoadConfig(auto) elseif self.AutoSave then self:LoadConfig(self.ConfigFile) end
end
function Window:_saveUI()
    if not self.SaveUI then return end
    local a = State.AccentName ~= "Custom" and State.AccentName or { State.Accent.R, State.Accent.G, State.Accent.B }
    writeJson(self.Folder .. "/ui.json", { Accent = a, Glass = State.Glass, Scale = self.ScaleIndex, Blur = self.Blur, ToggleKey = self.ToggleKey })
end

-- ---- 設定タブ (見た目・キー・設定ファイル・閉じる) をまとめて作る ----
function Window:CreateSettingsTab(o)
    o = o or {}
    local W = self
    local S = W:CreateTab({ Name = o.Name or "Settings", Icon = o.Icon or "settings", Desc = o.Desc or "appearance & configs" })

    S:CreateSection({ Name = "appearance", Icon = "palette" })
    local colors, cur = {}, 1
    for i, x in ipairs(Lib.Accents) do colors[i] = x[2] if x[1] == State.AccentName then cur = i end end
    S:CreateSwatches({ Name = "Accent", Icon = "droplet", IconColor = Lib.Colors.pink, Colors = colors, Current = cur, Callback = function(_, i)
        setAccent(Lib.Accents[i][1])
        W:_saveUI()
    end })
    S:CreateSegment({ Name = "Glass", Icon = "layers", IconColor = Lib.Colors.blue, Options = Lib.GlassStyles, CurrentOption = State.Glass, Callback = function(v)
        State.Glass = v
        applyGlass()
        W:_saveUI()
    end })
    S:CreateSegment({ Name = "Size", Icon = "scaling", IconColor = Lib.Colors.teal, Options = { "S", "M", "L" }, CurrentOption = ({ "S", "M", "L" })[W.ScaleIndex], Callback = function(v)
        W:SetScale(table.find({ "S", "M", "L" }, v))
        W:_saveUI()
    end })
    S:CreateToggle({ Name = "Background blur", Desc = "開いている間、後ろの画面をぼかす", Icon = "aperture", IconColor = Lib.Colors.indigo, CurrentValue = W.Blur, Callback = function(v)
        W:SetBlur(v)
        W:_saveUI()
    end })

    S:CreateSection({ Name = "controls", Icon = "keyboard" })
    S:CreateKeybind({ Name = "Toggle UI", Icon = "keyboard", IconColor = Lib.Colors.gray, CurrentKeybind = W.ToggleKey, ChangedCallback = function(k)
        W.ToggleKey = k
        W:_saveUI()
    end })

    S:CreateSection({ Name = "configs", Icon = "folder" })
    local nameBox = S:CreateInput({ Name = "Config name", Icon = "file-pen-line", IconColor = Lib.Colors.orange, PlaceholderText = "my config" })
    local list = S:CreateDropdown({ Name = "Configs", Icon = "folder-open", IconColor = Lib.Colors.yellow, Options = W:ListConfigs(), CurrentOption = W:GetAutoload() })
    local function refresh() list:Refresh(W:ListConfigs(), true) end
    local function chosen() return (nameBox.Value ~= "" and nameBox.Value) or list.Value end
    S:CreateButton({ Name = "Save", Icon = "save", IconColor = Lib.Colors.green, Callback = function()
        local n = chosen()
        if not n or n == "" then W:Notify({ Title = "name it first", Content = "Config name に名前を入れてください", Type = "Warning" }) return end
        W:SaveConfig(n)
        refresh()
        list:Set(n, true)
        W:Notify({ Title = "saved", Content = n, Type = "Success", Duration = 2.5 })
    end })
    S:CreateButton({ Name = "Load", Icon = "download", IconColor = Lib.Colors.blue, Callback = function()
        local n = list.Value or chosen()
        if n and W:LoadConfig(n) then W:Notify({ Title = "loaded", Content = n, Type = "Success", Duration = 2.5 })
        else W:Notify({ Title = "not found", Content = tostring(n or "選んでください"), Type = "Error" }) end
    end })
    S:CreateButton({ Name = "Set as autoload", Icon = "star", IconColor = Lib.Colors.yellow, Callback = function()
        local n = list.Value or chosen()
        if not n then return end
        W:SetAutoload(n)
        W:Notify({ Title = "autoload", Content = n .. " を次から自動で読み込みます", Duration = 2.5 })
    end })
    S:CreateButton({ Name = "Delete", Icon = "trash-2", IconColor = Lib.Colors.red, Style = "Danger", Callback = function()
        local n = list.Value
        if not n then return end
        W:Confirm({ Title = "delete " .. n .. "?", Content = "この設定ファイルを消します", Icon = "trash-2", IconColor = Lib.Colors.red, ConfirmText = "Delete", Danger = true, Callback = function()
            W:DeleteConfig(n)
            if W:GetAutoload() == n then W:SetAutoload(nil) end
            refresh()
            list:Set(nil, true)
        end })
    end })

    S:CreateSection({ Name = "danger zone", Icon = "triangle-alert" })
    S:CreateButton({ Name = "Unload", Desc = "UI を完全に消す", Icon = "power", IconColor = Lib.Colors.red, Style = "Danger", Callback = function()
        W:Confirm({ Title = "unload " .. W.Name .. "?", Icon = "power", IconColor = Lib.Colors.red, ConfirmText = "Unload", Danger = true, Callback = function() W:Destroy() end })
    end })
    return S
end

