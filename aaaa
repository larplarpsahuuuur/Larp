function Lib:GetFlag(f) local e = Lib.Flags[f] return e and e.Value end
function Lib:SetFlag(f, v) local e = Lib.Flags[f] if e and e.Set then e:Set(v) end end
function Lib:OnFlagChanged(f, fn) FlagHooks[f] = FlagHooks[f] or {} table.insert(FlagHooks[f], fn) end
function Lib:LoadConfiguration() for _, W in ipairs(Lib.Windows) do W:LoadConfiguration() end end
function Lib:Notify(o) local W = Lib.Windows[#Lib.Windows] if W then return W:Notify(o) end end
function Lib:SetAccent(a) setAccent(a) end
function Lib:GetAccent() return State.Accent end
function Lib:SetGlass(g) if GLASS[g] then State.Glass = g applyGlass() end end
function Lib:SetAcon(a) Lib.Acon = a end
function Lib:Icon(name) return resolveIcon(name) end
function Lib:Unload()
    for i = #Lib.Windows, 1, -1 do Lib.Windows[i]:Destroy() end
    task.delay(0.5, function()
        for _, c in ipairs(Conns) do pcall(function() c:Disconnect() end) end
    end)
    if G.RofyUI == Lib then G.RofyUI = nil end
end

G.RofyUI = Lib
return Lib
