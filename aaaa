end

-- ---- ラベル (Update を渡すと定期的に書き換える) ----
function Container:CreateLabel(a, icon, color)
    local o = type(a) == "table" and a or { Text = a, Icon = icon, Color = color }
    if o.Icon == 0 then o.Icon = nil end
    local W = self.Window
    local x = o.Icon and 38 or 14
    local r, _, card = self:_cardRow(36, x)
    if o.Icon then
        local ic = new("ImageLabel", { Position = UDim2.fromOffset(15, 11), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ImageColor3 = o.Color or C.Sub, ZIndex = 2, Parent = r })
        setIcon(ic, o.Icon)
    end
    local lb = text({ Position = UDim2.fromOffset(x, 0), Size = UDim2.new(1, -x - 12, 1, 0), Text = tostring(o.Text or ""), TextSize = 12, TextColor3 = o.Color or C.Sub, ZIndex = 2, Parent = r })
    local e = newElement(self, { Name = o.Text }, { row = r, card = card, H0 = 36 }, "Label")
    function e:Set(t, c)
        lb.Text = tostring(t)
        if c then lb.TextColor3 = c end
    end
    if type(o.Update) == "function" then
        task.spawn(function()
            while r.Parent and W.Alive do
                local ok, v = pcall(o.Update)
                if ok and v ~= nil then lb.Text = tostring(v) end
                task.wait(o.UpdateRate or 1)
            end
        end)
    end
    return e
end

-- ---- 区切り (カードをここで切って、次から新しいカード) ----
