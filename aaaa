-- iOS のロック画面のように重ねる: ふだんは新しい 1 枚の下に古いのが少しだけ覗く
-- マウスを乗せると広がって全部見える (乗せている間は時間も止まる)
function Window:_layoutToasts()
    local n = #self.Toasts
    local open = self._toastHover or n == 1
    local y = 0
    for i = n, 1, -1 do
        local r = self.Toasts[i]
        local depth = n - i
        if open then
            r.ys.t, r.ss.t, r.fa.t = -y, 1, 1
            y += r.h + 10
        else
            r.ys.t = depth * 9
            r.ss.t = 1 - depth * 0.05
            r.fa.t = depth == 0 and 1 or depth == 1 and 0.6 or depth == 2 and 0.3 or 0
        end
        r.T.ZIndex = 100 - depth
    end
end
function Window:_watchToasts()
    if self._toastStep then return end
    local W = self
    local outAt = 0
    self._toastStep = onStep(function()
        if #W.Toasts == 0 then W._toastHover = false return end
        local m = UserInputService:GetMouseLocation()
        local over = false
        for _, r in ipairs(W.Toasts) do
            local p, s = r.T.AbsolutePosition, r.T.AbsoluteSize
            if m.X >= p.X and m.X <= p.X + s.X and m.Y >= p.Y - 4 and m.Y <= p.Y + s.Y + 4 then over = true break end
        end
        if over then outAt = os.clock() end
        -- 出てすぐには閉じない (広がる途中でマウスが外れても、ばたつかないように)
        local want = over or (W._toastHover and os.clock() - outAt < 0.3)
        if want ~= (W._toastHover or false) then
            W._toastHover = want
            W:_layoutToasts()
        end
    end)
end

function Window:Notify(o)
    if type(o) ~= "table" then o = { Title = tostring(o) } end
    local W = self
    if not W.Alive then return end
    local kind = TYPE_ICON[o.Type or ""] and o.Type or "Info"
    if o.Island then
        W.Island:Flash(tostring(o.Title or ""), o.Content, o.Duration or 2.5, o.Icon or TYPE_ICON[kind][1], kind ~= "Info" and typeColor(kind) or nil)
        return
    end
    local WIDTH = 300
    local title, content = tostring(o.Title or "notice"), tostring(o.Content or o.Text or "")
    local dur = o.Duration or 4
    local th = content ~= "" and textHeight(content, 12, WIDTH - 70) or 0
    local acts = o.Actions or {}
    local h = math.max(60, 14 + 18 + (th > 0 and th + 4 or 0) + (#acts > 0 and 36 or 0) + 16)

    local T = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, WIDTH + 40, 1, 0), Size = UDim2.fromOffset(WIDTH, h), BackgroundTransparency = 1, ZIndex = 100, Parent = W.ToastHolder })
    local tscale = new("UIScale", { Parent = T })
    local fade = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, ZIndex = 61, Parent = T })
    local card = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = fade })
    local g = glass(card, 18, { blobs = false })
    local col = typeColor(kind)
    local sq = new("Frame", { Position = UDim2.fromOffset(12, 14), Size = UDim2.fromOffset(30, 30), BackgroundColor3 = col, ZIndex = 2, Parent = card })
    corner(sq, 9)
    new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, rgb(200, 200, 212)), Parent = sq })
    local ic = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundTransparency = 1, ImageColor3 = contrast(col), ZIndex = 3, Parent = sq })
    setIcon(ic, o.Icon or TYPE_ICON[kind][1], TYPE_ICON[kind])
    text({ Position = UDim2.fromOffset(54, 13), Size = UDim2.new(1, -90, 0, 18), Text = title, FontFace = F.Bold, TextSize = 13, ZIndex = 2, Parent = card })
    if th > 0 then
        text({ Position = UDim2.fromOffset(54, 32), Size = UDim2.new(1, -68, 0, th), Text = content, TextSize = 12, TextColor3 = C.Sub, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 2, Parent = card })
    end
    -- 右上はふだん「now」、乗せると × に変わる
    local closeBtn = iconButton(card, "x", 12, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -6, 0, 6), ZIndex = 3, Visible = false })
    local nowLb = text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 13), Size = UDim2.fromOffset(40, 18), Text = o.Time or "now", TextSize = 11, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 2, Parent = card })
    card.MouseEnter:Connect(function() closeBtn.Visible = true nowLb.Visible = false end)
    card.MouseLeave:Connect(function() closeBtn.Visible = false nowLb.Visible = true end)
    local trk = new("Frame", { Position = UDim2.new(0, 16, 1, -6), Size = UDim2.new(1, -32, 0, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0.88, BorderSizePixel = 0, ZIndex = 2, Parent = card })
    corner(trk, UDim.new(1, 0))
    local fill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = col, BorderSizePixel = 0, ZIndex = 2, Parent = trk })
    corner(fill, UDim.new(1, 0))

    local xs, ys, a = spring(WIDTH + 40, 20, 0.84), spring(0, 22, 0.88), spring(0, 16, 1)
    local ss, fa = spring(1, 22, 0.9), spring(1, 18, 1)
    xs.t, a.t = 0, 1
    local rec = { h = h, ys = ys, ss = ss, fa = fa, T = T }
    table.insert(W.Toasts, rec)
    W:_watchToasts()
    W:_layoutToasts()
    ys.x = ys.t
    local remaining, closing = dur, false
    local stopShadow = softShadow(T, 18, function() return a.x * fa.x end)
    local stop
    local function close()
        if closing then return end
        closing = true
        xs.t, a.t = WIDTH + 40, 0
        local i = table.find(W.Toasts, rec)
        if i then table.remove(W.Toasts, i) end
        W:_layoutToasts()
        task.delay(0.6, function()
            stop() stopShadow()
            unspring(xs) unspring(ys) unspring(a) unspring(ss) unspring(fa)
            Glasses[g] = nil
            T:Destroy()
        end)
    end
    rec.close = close
    closeBtn.MouseButton1Click:Connect(close)
    if #acts > 0 then
        local row = new("Frame", { Position = UDim2.fromOffset(54, 32 + th + 8), Size = UDim2.new(1, -68, 0, 26), BackgroundTransparency = 1, ZIndex = 2, Parent = card })
        new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6), Parent = row })
        for i, act in ipairs(acts) do
            local b = new("TextButton", {
                Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, Text = tostring(act.Name or act.Title or "OK"),
                FontFace = F.Bold, TextSize = 12, TextColor3 = i == 1 and contrast(col) or C.Text, BackgroundColor3 = col,
                AutoButtonColor = false, LayoutOrder = i, ZIndex = 3, Parent = row,
            })
            new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12), Parent = b })
            makeGlassButton(b, i == 1)
            if i == 1 then b.BackgroundColor3 = col end
            b.MouseButton1Click:Connect(function() close() call(act.Callback) end)
        end
    end
    stop = onStep(function(dt)
        T.Position = UDim2.new(0.5, math.floor(xs.x + 0.5), 1, math.floor(ys.x + 0.5))
        tscale.Scale = ss.x
        fade.GroupTransparency = 1 - clamp01(a.x) * clamp01(fa.x)
        T.Visible = fa.x > 0.01
        if not closing and not W._toastHover then
            remaining -= dt
            fill.Size = UDim2.fromScale(clamp01(remaining / dur), 1)
            if remaining <= 0 then close() end
        end
    end)
    while #W.Toasts > 5 do W.Toasts[1].close() end
    return { Close = close }
end

