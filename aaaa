            W._blur.Size = (W.Blur and 16 or 0) * clamp01(WinPop.spring.x)
        end
    end)

    -- 表示 / 非表示のキー
    conn(UserInputService.InputBegan:Connect(function(input)
        if not W.Alive or Lib._listening then return end
        -- Esc: ダイアログ → 検索 の順に閉じる
        if input.KeyCode == Enum.KeyCode.Escape and W.Visible then
            if W._dialogClose then W._dialogClose() return end
            if W._searching then W.SearchBox.Text = "" W.SearchBox:ReleaseFocus() W._setSearching(false) return end
        end
        if UserInputService:GetFocusedTextBox() then return end
        -- Ctrl + F: 検索
        if input.KeyCode == Enum.KeyCode.F and W.Visible and (UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)) then
            W._setSearching(true)
            return
        end
        if keyMatch(input, W.ToggleKey) then W:Toggle() end
    end))

    table.insert(Lib.Windows, W)

    -- ---- 読み込み (Dynamic Island) ----
    task.spawn(function() local A = Lib.Acon if A then pcall(A.Set, A) end end) -- アイコンを先に読んでおく
    if o.Loading ~= false then
        local L = type(o.Loading) == "table" and o.Loading or {}
        task.spawn(function()
            local ctl = W.Island:Loading(L.Title or o.LoadingTitle or W.Name)
            local steps = L.Steps or { o.LoadingSubtitle or "preparing", "loading interface", "almost there" }
            local dur = L.Duration or 1.4
            local t0 = os.clock()
            while W.Alive do
                local p = clamp01((os.clock() - t0) / dur)
                ctl.Set(1 - (1 - p) ^ 3, steps[math.min(#steps, math.floor(p * #steps) + 1)])
                if p >= 1 then break end
                task.wait()
            end
            ctl.Done(L.Ready or "ready")
            task.wait(0.6)
            if not W.Alive then return end
            W.Island:EndLoading()
            W:SetVisible(true)
        end)
    else
        W:SetVisible(true)
    end
    return W
end

