-- ファイル
local function canFile() return type(writefile) == "function" and type(readfile) == "function" and type(isfile) == "function" end
local function ensureFolder(path)
    if type(isfolder) ~= "function" or type(makefolder) ~= "function" then return end
    local acc = ""
    for part in string.gmatch(path, "[^/]+") do
        acc = acc == "" and part or (acc .. "/" .. part)
        if not isfolder(acc) then pcall(makefolder, acc) end
    end
end
local function readJson(path)
    if not canFile() then return nil end
    local ok, data = pcall(function()
        if isfile(path) then return HttpService:JSONDecode(readfile(path)) end
    end)
    return ok and data or nil
end
local function writeJson(path, data)
    if not canFile() then return false end
    local dir = path:match("^(.*)/[^/]+$")
    if dir then ensureFolder(dir) end
    return pcall(writefile, path, HttpService:JSONEncode(data))
end
local function encode(v)
    if typeof(v) == "Color3" then return { __color = { v.R, v.G, v.B } } end
    if typeof(v) == "EnumItem" then return v.Name end
    return v
end
local function decode(v)
    if type(v) == "table" and v.__color then return Color3.new(v.__color[1], v.__color[2], v.__color[3]) end
    return v
end

local FlagHooks = {}
Lib._listening = false

-- ===================================================================
-- 要素の共通部分
-- ===================================================================
local Element = {}
Element.__index = Element

function Element:OnChanged(fn) table.insert(self._hooks, fn) return self end
function Element:Get() return self.Value end
function Element:_notify(...)
    for _, fn in ipairs(self._hooks) do call(fn, ...) end
    if self.Flag then
        for _, fn in ipairs(FlagHooks[self.Flag] or {}) do call(fn, ...) end
        if self.Window.AutoSave then self.Window:_queueSave() end
    end
end
function Element:_fire(...)
    call(self._cb, ...)
    self:_notify(...)
end
function Element:SetVisible(v)
    v = v ~= false
    if self._item then self._item.visible = v end
    if self.Row then self.Row.Visible = v end
end
function Element:SetTitle(t) if self._title then self._title.Text = tostring(t) end end
function Element:SetDesc(t) if self._desc then self._desc.Text = tostring(t) end end
function Element:SetCallback(fn) self._cb = fn end
function Element:Destroy()
    if self.Flag then Lib.Flags[self.Flag] = nil self.Window.Flags[self.Flag] = nil end
    if self.Row then self.Row:Destroy() end
end
-- 鍵をかける (行が暗くなり、右に不透明なバッジ「鍵 + 理由」が出て、下の値を隠す)
function Element:SetLocked(on, reason)
    if not self.Row then return end
    local L = self._lock
    if not L then
        local H0 = self._H0 or 40
        local ov = new("TextButton", {
            Position = UDim2.fromOffset(4, 1), Size = UDim2.new(1, -8, 1, -2), BackgroundColor3 = rgb(8, 8, 10), BackgroundTransparency = 1,
            Text = "", AutoButtonColor = false, ZIndex = 20, Visible = false, Parent = self.Row,
        })
        corner(ov, 12)
        local badge = new("Frame", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0, H0 / 2 - 1), Size = UDim2.fromOffset(0, 24),
            AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = rgb(18, 18, 22), ZIndex = 21, Parent = ov,
        })
        corner(badge, UDim.new(1, 0))
        gstroke(badge, 0.78, 0.2, 0.9)
        new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 10), Parent = badge })
        new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = badge })
        local ic = new("ImageLabel", { Size = UDim2.fromOffset(12, 12), BackgroundTransparency = 1, ImageColor3 = C.Sub, LayoutOrder = 1, ZIndex = 22, Parent = badge })
        setIcon(ic, "lock")
        local rs = text({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = "", TextSize = 11, FontFace = F.Bold, TextColor3 = C.Sub, TextTruncate = Enum.TextTruncate.None, LayoutOrder = 2, ZIndex = 22, Parent = badge })
        local sc = new("UIScale", { Scale = 0.8, Parent = badge })
        local a = spring(0, 22, 0.82)
        L = { ov = ov, rs = rs, a = a }
        onStep(function()
            local x = a.x
            ov.Visible = x > 0.01
            if not ov.Visible then return end
            ov.BackgroundTransparency = 1 - 0.5 * clamp01(x)
            sc.Scale = 0.8 + 0.2 * x
            badge.BackgroundTransparency = 1 - clamp01(x)
            ic.ImageTransparency = 1 - clamp01(x)
            rs.TextTransparency = 1 - clamp01(x)
        end)
        self._lock = L
    end
    self.Locked = on and true or false
    L.rs.Text = (reason and reason ~= "") and reason or "locked"
    L.a.t = self.Locked and 1 or 0
end

