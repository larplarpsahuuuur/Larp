local Window = {}
Window.__index = Window
local SCALES = { 0.85, 1, 1.12 }
local DEFAULT_LOGO = 113611982917241

function Lib:CreateWindow(o)
    o = o or {}
    if o.Acon then Lib.Acon = o.Acon end
    Lib.Acon = Lib.Acon or G.Acon
    local W = setmetatable({}, Window)
    W.Alive = true
    W.Name = o.Name or o.Title or "Rofy"
    W.Subtitle = o.Subtitle or ""
    W.Icon = o.Icon or "sparkles"
    -- ロゴ (タブのカプセルの上・島・Watermark に出る)。asset id か "rbxassetid://..."
    local logo = o.Logo or DEFAULT_LOGO
    W.Logo = (logo == false and "") or (tonumber(logo) and ("rbxassetid://" .. tostring(logo))) or tostring(logo)
    W.IslandFeedback = o.IslandFeedback ~= false
    W.Tabs, W.Flags, W.Toasts = {}, {}, {}
    W.ToggleKey = keyName(o.ToggleUIKeybind or o.ToggleKey or "RightShift")
    W.OpenButton = o.OpenButton ~= false
    local cs = o.ConfigurationSaving
    W.Folder = (type(cs) == "table" and cs.FolderName) or o.Folder or ("RofyUI/" .. W.Name)
    W.AutoSave = type(cs) == "table" and cs.Enabled == true
    W.ConfigFile = (type(cs) == "table" and cs.FileName) or "autosave"
    W.SaveUI = o.SaveUI ~= false

    -- 見た目の設定: スクリプトの指定 → 前に保存したもの (設定タブで選んだ物が勝つ)
    local ui = { Accent = o.Accent or o.Theme, Glass = o.Glass, Scale = o.Scale or 2, Blur = o.BackgroundBlur == true, ToggleKey = W.ToggleKey }
    if W.SaveUI then
        local saved = readJson(W.Folder .. "/ui.json")
        if type(saved) == "table" then for k, v in pairs(saved) do ui[k] = v end end
    end
    if ui.Glass and GLASS[ui.Glass] then State.Glass = ui.Glass end
    if ui.Accent then setAccent(ui.Accent) end
    W.ToggleKey = keyName(ui.ToggleKey)
    W.ScaleIndex = SCALES[ui.Scale] and ui.Scale or 2
    W.Blur = ui.Blur == true

    -- 同じ名前の古いウィンドウを消す
    G.RofyUIWindows = G.RofyUIWindows or {}
    local guiName = "RofyUI_" .. W.Name
    if G.RofyUIWindows[guiName] then pcall(function() G.RofyUIWindows[guiName]:Destroy(true) end) end
    G.RofyUIWindows[guiName] = W
    pcall(function()
        local parents = { CoreGui, LocalPlayer:FindFirstChild("PlayerGui") }
        if type(gethui) == "function" then table.insert(parents, 1, gethui()) end
        for _, par in ipairs(parents) do
            local old = par and par:FindFirstChild(guiName)
            if old then old:Destroy() end
        end
    end)

    local Gui = new("ScreenGui", { Name = guiName, ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = o.DisplayOrder or 60 })
    pcall(function() if syn and syn.protect_gui then syn.protect_gui(Gui) end end)
    pcall(function() Gui.Parent = (type(gethui) == "function" and gethui()) or CoreGui end)
    if not Gui.Parent then Gui.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    W.Gui = Gui

    -- 形: 左に浮いた黒いカプセル (タブ) と、右に 1 枚のすりガラスのシート
    --   シートの高さは中身に合わせてバネで伸び縮みする (MinHeight 〜 Size の高さ)
    local ORN, ORN_OPEN, GAP, LOGO_H = 52, 164, 10, 48
    W.LogoH = LOGO_H
    local SW, MAXH = 420, 500
    if typeof(o.Size) == "UDim2" then SW, MAXH = o.Size.X.Offset, o.Size.Y.Offset elseif typeof(o.Size) == "Vector2" then SW, MAXH = o.Size.X, o.Size.Y end
    local MINH = math.min(o.MinHeight or 240, MAXH)
    local RW = ORN + GAP + SW

    local Root = new("Frame", { Name = "Root", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(RW, MAXH), BackgroundTransparency = 1, Parent = Gui })
    local RootScale = new("UIScale", { Parent = Root })
    W.Root, W.RootScale = Root, RootScale
    function W:_fit()
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        return math.min(1, (vp.X - 24) / RW, (vp.Y - 24) / MAXH)
    end
    RootScale.Scale = SCALES[W.ScaleIndex] * W:_fit()
    local posX, posY = spring(0, 26, 0.9), spring(0, 26, 0.9)
    onStep(function() Root.Position = UDim2.new(0.5, math.floor(posX.x + 0.5), 0.5, math.floor(posY.x + 0.5)) end)

    local sh = spring(MINH, 16, 0.92)      -- シートの高さ
    local ow = spring(ORN, 24, 0.86)       -- カプセルの幅 (乗せると広がる)
    W.OrnH = 8 + LOGO_H

    -- 影は開閉の CanvasGroup の外に置く (中だと切り取られる)
    local holder = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = Root })
    local WinPop = pop(holder, { from = 0.94, dy = 16, speed = 18, damp = 0.84 })
    W.Pop = WinPop
    local sheetShade = new("Frame", { Position = UDim2.fromOffset(ORN + GAP, 0), Size = UDim2.fromOffset(SW, MINH), BackgroundTransparency = 1, ZIndex = 0, Parent = Root })
    local ornShade = new("Frame", { Size = UDim2.fromOffset(ORN, 8), BackgroundTransparency = 1, ZIndex = 0, Parent = Root })
    softShadow(sheetShade, 26, function() return WinPop.spring.x end)
    softShadow(ornShade, 26, function() return WinPop.spring.x * 0.8 end)

    local Win = new("Frame", { Name = "Window", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = WinPop.body })
    W.Win = Win
    -- 開いている間はマウスを自由に (一人称でも触れる)
    new("TextButton", { Name = "Modal", Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Text = "", Modal = true, Parent = Win })

    -- ---- シート ----
    local Sheet = new("Frame", { Position = UDim2.fromOffset(ORN + GAP, 0), Size = UDim2.fromOffset(SW, MINH), BackgroundTransparency = 1, ZIndex = 2, Parent = Win })
    W.Sheet = Sheet
    W.Glass = glass(Sheet, 26)
    local headDrag = new("Frame", { Size = UDim2.new(1, -96, 0, 64), BackgroundTransparency = 1, ZIndex = 2, Parent = Sheet })
    W.TitleLabel = text({ Position = UDim2.fromOffset(22, 16), Size = UDim2.new(1, -120, 0, 26), Text = "", FontFace = F.Heavy, TextSize = 22, ZIndex = 3, Parent = Sheet })
    W.DescLabel = text({ Position = UDim2.fromOffset(22, 43), Size = UDim2.new(1, -120, 0, 14), Text = "", TextSize = 11, TextColor3 = C.Muted, ZIndex = 3, Parent = Sheet })
    local sBtn = iconButton(Sheet, "search", 16, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -48, 0, 18), ZIndex = 4 })
    local xBtn = iconButton(Sheet, "x", 16, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 18), ZIndex = 4 })

    -- 検索: 見出しが消えて、同じ場所に入力欄が浮かぶ
