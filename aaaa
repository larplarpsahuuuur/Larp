    local listTop = H0 + (useSearch and 42 or 6)
    local list = new("ScrollingFrame", {
        Position = UDim2.fromOffset(6, listTop), Size = UDim2.new(1, -12, 0, 0), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 2, ScrollBarImageColor3 = WHITE, ScrollBarImageTransparency = 0.7, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 3, Parent = body,
    })
    new("UIListLayout", { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

    local items, open = {}, false
    local hs = heightSpring(R.row, H0)
    local rot = spring(0, 22, 0.85)
    onStep(function()
        local p = clamp01((hs.x - H0) / 40)
        body.Visible = p > 0.01
        body.GroupTransparency = 1 - p
        chev.ImageColor3 = C.Sub:Lerp(accent(), clamp01(rot.x))
    end)

    local function isSel(v) if multi then return table.find(e.Value, v) ~= nil end return e.Value == v end
    local function paint()
        for _, it in ipairs(items) do
            local on = isSel(it.value)
            it.check.ImageColor3 = accent()
            tween(it.check, { ImageTransparency = on and 0 or 1 }, 0.15)
            tween(it.label, { TextColor3 = on and C.Text or C.Sub }, 0.15)
            it.label.FontFace = on and F.Bold or F.Medium
        end
        if multi then
            local t = {}
            for _, v in ipairs(e.Value) do t[#t + 1] = tostring(v) end
            valueLabel.Text = #t == 0 and "none" or table.concat(t, ", ")
        else
            valueLabel.Text = e.Value ~= nil and tostring(e.Value) or "none"
        end
    end
    local function targetH()
        if not open then return H0 end
        local n = 0
        for _, it in ipairs(items) do if it.btn.Visible then n += 1 end end
        local lh = math.max(math.min(n, o.MaxVisible or 6), 1) * 32
        list.Size = UDim2.new(1, -12, 0, lh)
        return listTop + lh + 6
    end
    local function build()
        for _, it in ipairs(items) do it.btn:Destroy() end
        items = {}
        for i, v in ipairs(e.Options) do
            local b = new("TextButton", { Size = UDim2.new(1, -4, 0, 30), BackgroundColor3 = WHITE, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 4, Parent = list })
            corner(b, 9)
            local lb = text({ Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -40, 1, 0), Text = tostring(v), TextSize = 12, TextColor3 = C.Sub, ZIndex = 4, Parent = b })
            local ck = new("ImageLabel", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ImageTransparency = 1, ZIndex = 4, Parent = b })
            setIcon(ck, "check")
            b.MouseEnter:Connect(function() tween(b, { BackgroundTransparency = 0.93 }, 0.12) end)
            b.MouseLeave:Connect(function() tween(b, { BackgroundTransparency = 1 }, 0.18) end)
            b.MouseButton1Click:Connect(function() PressedAt = os.clock() e:_pick(v) end)
            items[i] = { btn = b, label = lb, check = ck, value = v }
        end
        paint()
    end
    function e:_pick(v)
        if multi then
            local i = table.find(self.Value, v)
            if i then table.remove(self.Value, i) else table.insert(self.Value, v) end
            paint()
            self:_fire(table.clone(self.Value))
        else
            if self.Value == v and o.AllowNone then self.Value = nil else self.Value = v end
            paint()
            self:_fire(self.Value)
            self:Open(false)
        end
    end
    function e:Set(v, silent)
        if multi then
            self.Value = {}
            if type(v) == "table" then for _, x in ipairs(v) do table.insert(self.Value, x) end elseif v ~= nil then self.Value = { v } end
        else
            if type(v) == "table" then v = v[1] end
            self.Value = v
        end
        paint()
        if not silent then self:_fire(multi and table.clone(self.Value) or self.Value) end
    end
    function e:Refresh(options, keep)
        self.Options = options or {}
        if not keep then if multi then self.Value = {} else self.Value = nil end end
        build()
        hs.t = targetH()
    end
    function e:Open(v)
        open = v and true or false
        if search then search.Text = "" end
        for _, it in ipairs(items) do it.btn.Visible = true end
        hs.t = targetH()
        rot.t = open and 1 or 0
    end
    if search then
        search:GetPropertyChangedSignal("Text"):Connect(function()
            local q = string.lower(search.Text)
            for _, it in ipairs(items) do it.btn.Visible = q == "" or string.find(string.lower(tostring(it.value)), q, 1, true) ~= nil end
            hs.t = targetH()
        end)
    end
    hit.MouseButton1Click:Connect(function() e:Open(not open) end)
    build()
    return e
end

