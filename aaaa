-- 入れ物 (タブ・グループ) と行
-- ===================================================================
local Container = {}
Container.__index = Container

local function newContainer(W, page, list, extra)
    local c = setmetatable({ Window = W, Page = page, List = list, Order = 0 }, Container)
    for k, v in pairs(extra or {}) do c[k] = v end
    return c
end
-- 並び順はページ全体で 1 本 (グループを後から足しても混ざらない)
function Container:_next()
    self.Page.order = (self.Page.order or 0) + 1
    return self.Page.order
end
-- 今のカード (iOS の設定のように、行は 1 枚のカードにまとめて細い線で区切る)
function Container:_newCard()
    local f = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = WHITE,
        BackgroundTransparency = 0.955, LayoutOrder = self:_next(), Parent = self.List,
    })
    corner(f, 16)
    gstroke(f, 0.88, 0.45, 0.97)
    new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Parent = f })
    new("UIPadding", { PaddingTop = UDim.new(0, 3), PaddingBottom = UDim.new(0, 3), Parent = f })
    self.Card = { frame = f, n = 0, items = {} }
    table.insert(self.Page.cards, self.Card)
    return self.Card
end
function Container:_card() return self.Card or self:_newCard() end
-- カードに 1 行足す (2 行目からは上に細い線)
function Container:_cardRow(height, indent, auto)
    local card = self:_card()
    card.n += 1
    local r = new("Frame", {
        Size = UDim2.new(1, 0, 0, height or 40), AutomaticSize = auto and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
        BackgroundTransparency = 1, LayoutOrder = card.n, Parent = card.frame,
    })
    local hl = new("Frame", { Position = UDim2.fromOffset(4, 1), Size = UDim2.new(1, -8, 1, -2), BackgroundColor3 = WHITE, BackgroundTransparency = 1, ZIndex = 1, Parent = r })
    corner(hl, 12)
    if card.n > 1 then
        new("Frame", { Position = UDim2.fromOffset(indent or 14, 0), Size = UDim2.new(1, -(indent or 14) - 14, 0, 1), BackgroundColor3 = WHITE, BackgroundTransparency = 0.93, BorderSizePixel = 0, ZIndex = 2, Parent = r })
    end
    return r, hl, card
end

-- ツールチップ
local function attachTip(W, obj, str)
    local hovering = false
    obj.MouseEnter:Connect(function()
        hovering = true
        local my = {}
        W._tipToken = my
        task.delay(0.4, function()
            if hovering and W._tipToken == my then W:_showTip(str) end
        end)
    end)
    obj.MouseLeave:Connect(function()
        hovering = false
        W:_hideTip()
    end)
end

-- 行: うすいガラスの板 + iOS 設定のような色付きの角丸アイコン + 名前 + 説明
local function baseRow(cont, o, opts)
    opts = opts or {}
    local hasDesc = o.Desc ~= nil and o.Desc ~= ""
    local H0
    if opts.stacked then H0 = hasDesc and 48 or 36 else H0 = hasDesc and 50 or 40 end
    local height = opts.stacked and (H0 + (opts.extra or 0)) or H0
    local r, hl, card = cont:_cardRow(height, o.Icon and 50 or 14)
    r.Name = tostring(o.Name or "Row")
    r.ClipsDescendants = opts.clip or false
    r.MouseEnter:Connect(function() tween(hl, { BackgroundTransparency = 0.965 }, 0.15) end)
    r.MouseLeave:Connect(function() tween(hl, { BackgroundTransparency = 1 }, 0.25) end)

    local x = 14
    if o.Icon then
        local sq = new("Frame", { Position = UDim2.fromOffset(10, math.floor((H0 - 28) / 2)), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = o.IconColor or accent(), ZIndex = 2, Parent = r })
        corner(sq, 8)
        new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, rgb(200, 200, 212)), Parent = sq })
        gstroke(sq, 0.78, 0.1, 1)
        local ic = new("ImageLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(16, 16),
            BackgroundTransparency = 1, ImageColor3 = contrast(o.IconColor or accent()), ZIndex = 3, Parent = sq,
        })
        setIcon(ic, o.Icon)
        if not o.IconColor then
            onAccent(function(a) sq.BackgroundColor3 = a ic.ImageColor3 = contrast(a) end)
        end
        x = 50
    end
    local reserve = (opts.right or 0) + 10
    local scale = 1 - (opts.rightScale or 0)
    local title, desc
    if hasDesc then
        title = text({ Position = UDim2.fromOffset(x, math.floor(H0 / 2) - 17), Size = UDim2.new(scale, -x - reserve, 0, 18), Text = tostring(o.Name or ""), FontFace = F.Medium, TextSize = 14, ZIndex = 2, Parent = r })
        desc = text({ Position = UDim2.fromOffset(x, math.floor(H0 / 2) + 2), Size = UDim2.new(scale, -x - reserve, 0, 14), Text = tostring(o.Desc), TextSize = 11, TextColor3 = C.Muted, ZIndex = 2, Parent = r })
    else
        title = text({ Position = UDim2.fromOffset(x, 0), Size = UDim2.new(scale, -x - reserve, 0, H0), Text = tostring(o.Name or ""), FontFace = F.Medium, TextSize = 14, ZIndex = 2, Parent = r })
    end
    return { row = r, hl = hl, card = card, title = title, desc = desc, H0 = H0, x = x }
end

local function newElement(cont, o, R, kind)
    local W = cont.Window
    local e = setmetatable({
        Type = kind, Window = W, Row = R.row, Flag = o.Flag, Name = o.Name,
        _cb = o.Callback, _hooks = {}, _title = R.title, _desc = R.desc, _H0 = R.H0,
    }, Element)
    e._item = { frame = R.row, text = string.lower(tostring(o.Name or o.Text or o.Title or "") .. " " .. tostring(o.Desc or "")), visible = true }
    table.insert(cont.Page.items, e._item)
    if R.card then table.insert(R.card.items, e._item) end
    if o.Flag then Lib.Flags[o.Flag] = e W.Flags[o.Flag] = e end
    if o.Tooltip then attachTip(W, R.row, o.Tooltip) end
    if o.Locked then e:SetLocked(true, o.LockedReason) end
    if o.Visible == false then e:SetVisible(false) end
    -- DependsOn = "Flag" / { Flag = "", Value = 値か関数, Mode = "Lock", Reason = "" }
    if o.DependsOn then
        local dep = o.DependsOn
        local flag = type(dep) == "table" and dep.Flag or dep
        local test = type(dep) == "table" and dep.Value
        task.defer(function()
            local d = Lib.Flags[flag]
            if not d then return end
            local function upd(v)
                local ok
                if type(test) == "function" then ok = test(v) elseif test ~= nil then ok = v == test else ok = v and true or false end
                if type(dep) == "table" and dep.Mode == "Lock" then e:SetLocked(not ok, dep.Reason) else e:SetVisible(ok) end
            end
            upd(d.Value)
            d:OnChanged(upd)
        end)
    end
    return e
end

-- 高さがバネで変わる行 (ドロップダウン・色)
local function heightSpring(row, h0)
    local hs = spring(h0, 24, 0.9)
    local last = -1
    onStep(function()
        local h = math.floor(hs.x + 0.5)
        if h ~= last then last = h row.Size = UDim2.new(1, 0, 0, h) end
    end)
    return hs
end

