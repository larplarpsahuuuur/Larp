-- ---- スイッチ (iOS。動く間だけつまみが液体のように伸びる) ----
function Container:CreateToggle(o)
    o = o or {}
    local W = self.Window
    local key = o.Keybind and keyName(o.Keybind)
    local R = baseRow(self, o, { right = key and 96 or 56 })
    local e = newElement(self, o, R, "Toggle")
    e.Value = (o.CurrentValue or o.Default) == true
    local sw = new("Frame", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, R.H0 / 2), Size = UDim2.fromOffset(44, 26),
        BackgroundColor3 = C.Raised, ZIndex = 2, Parent = R.row,
    })
    corner(sw, UDim.new(1, 0))
    local swStroke = stroke(sw, WHITE, 0.88, 1)
    local knob = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Size = UDim2.fromOffset(22, 22), BackgroundColor3 = WHITE, ZIndex = 3, Parent = sw })
    corner(knob, UDim.new(1, 0))
    new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, rgb(225, 225, 232)), Parent = knob })
    stroke(knob, BLACK, 0.85, 1)
    local x = spring(e.Value and 1 or 0, 26, 0.8)
    local press = spring(0, 30, 1)
    onStep(function()
        local k = x.x
        local stretch = math.clamp(math.abs(x.v) * 0.045, 0, 7) + press.x * 5
        local w = 22 + stretch
        knob.Size = UDim2.fromOffset(w, 22)
        knob.Position = UDim2.new(0, 2 + (40 - w) * clamp01(k), 0.5, 0)
        sw.BackgroundColor3 = C.Raised:Lerp(accent(), clamp01(k))
    end)
    if key then
        local chip = text({
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -64, 0, R.H0 / 2), Size = UDim2.fromOffset(32, 18),
            Text = keyLabel(key), FontFace = F.Bold, TextSize = 10, TextColor3 = C.Muted, TextXAlignment = Enum.TextXAlignment.Center,
            BackgroundColor3 = WHITE, BackgroundTransparency = 0.93, ZIndex = 2, Parent = R.row,
        })
        corner(chip, 6)
        e._chip = chip
        conn(UserInputService.InputBegan:Connect(function(input, processed)
            if not W.Alive or processed or Lib._listening or UserInputService:GetFocusedTextBox() then return end
            if keyMatch(input, key) and not e.Locked then
                e:Set(not e.Value)
                -- キーで切り替えた時は、上の島に小さく出す (UI を閉じていても分かる)
                if W.IslandFeedback then
                    W.Island:Flash(tostring(o.Name or ""), e.Value and "on" or "off", 1.4, o.Icon or "power", e.Value and (o.IconColor or accent()) or C.Raised)
                end
            end
        end))
    end
    local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = R.row })
    hit.MouseEnter:Connect(function() tween(swStroke, { Transparency = 0.65 }, 0.15) end)
    hit.MouseLeave:Connect(function() tween(swStroke, { Transparency = 0.88 }, 0.2) press.t = 0 end)
    hit.MouseButton1Down:Connect(function() press.t = 1 end)
    hit.MouseButton1Up:Connect(function() press.t = 0 end)
    hit.MouseButton1Click:Connect(function()
        R.hl.BackgroundTransparency = 0.9
        tween(R.hl, { BackgroundTransparency = 0.965 }, 0.5)
        e:Set(not e.Value)
    end)
    function e:Set(v, silent)
        v = v == true
        self.Value = v
        x.t = v and 1 or 0
        if not silent then self:_fire(v) end
    end
    return e
end

-- ---- スライダー (乗せると太く、値は打ち込みもできる) ----
function Container:CreateSlider(o)
    o = o or {}
    local R = baseRow(self, o, { stacked = true, extra = 26, right = 72 })
    local e = newElement(self, o, R, "Slider")
    local H0 = R.H0
    local range = o.Range or { o.Min or 0, o.Max or 100 }
    local min, max = range[1], range[2]
    local inc = o.Increment or 1
    local suffix = o.Suffix and tostring(o.Suffix) or ""
    local dec = inc < 1 and math.max(0, math.ceil(-math.log10(inc) - 1e-9)) or 0
    local function fmt(v) return string.format("%." .. dec .. "f", v) end
    e.Value = math.clamp(o.CurrentValue or o.Default or min, min, max)

    local box = new("TextBox", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, H0 / 2), Size = UDim2.fromOffset(70, 22),
        BackgroundTransparency = 1, Text = fmt(e.Value) .. suffix, FontFace = F.Bold, TextSize = 12, TextColor3 = C.Sub,
        TextXAlignment = Enum.TextXAlignment.Right, ClearTextOnFocus = false, ZIndex = 3, Parent = R.row,
    })
    local hit = new("TextButton", { Position = UDim2.fromOffset(14, H0 - 2), Size = UDim2.new(1, -28, 0, 20), BackgroundTransparency = 1, Text = "", ZIndex = 3, Parent = R.row })
    local trk = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 4), BackgroundColor3 = WHITE, BackgroundTransparency = 0.86, BorderSizePixel = 0, ZIndex = 3, Parent = hit })
    corner(trk, UDim.new(1, 0))
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Parent = trk })
    corner(fill, UDim.new(1, 0))
    new("UIGradient", { Color = ColorSequence.new(rgb(200, 200, 210), WHITE), Parent = fill })
    local thumb = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = WHITE, ZIndex = 4, Parent = trk })
    corner(thumb, UDim.new(1, 0))
    stroke(thumb, BLACK, 0.8, 1)
    local thumbScale = new("UIScale", { Scale = 0.8, Parent = thumb })
    -- つかんでいる間だけ、つまみの上に値の小さな吹き出し
    local bubble = new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = rgb(4, 4, 6), Visible = false, ZIndex = 8, Parent = hit })
    corner(bubble, UDim.new(1, 0))
    gstroke(bubble, 0.7, 0.2, 0.9)
    local bubbleText = text({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = "", FontFace = F.Bold, TextSize = 11, TextTruncate = Enum.TextTruncate.None, ZIndex = 9, Parent = bubble })
    new("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = bubbleText })
    local bubbleScale = new("UIScale", { Parent = bubble })
    local ba = spring(0, 26, 0.75)
    -- 段階が少ない時は目盛りを打つ (つまみが吸い付く場所が見える)
    local steps = math.floor((max - min) / inc + 0.5)
    if o.Ticks ~= false and steps >= 2 and steps <= 12 then
        for i = 1, steps - 1 do
            local d = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(i / steps, 0.5), Size = UDim2.fromOffset(2, 2), BackgroundColor3 = WHITE, BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 3, Parent = trk })
            corner(d, UDim.new(1, 0))
        end
    end
    local vs = spring((e.Value - min) / math.max(max - min, 1e-9), 22, 1)
    local hov = spring(0, 20, 0.9)
    local dragging
    hit.MouseEnter:Connect(function() hov.t = 1 end)
    hit.MouseLeave:Connect(function() if not dragging() then hov.t = 0 end end)
    onStep(function()
        local p = clamp01(vs.x)
        local h = hov.x
        trk.Size = UDim2.new(1, 0, 0, 4 + 3 * h)
        fill.Size = UDim2.fromScale(p, 1)
        thumb.Position = UDim2.fromScale(p, 0.5)
        thumbScale.Scale = 0.8 + 0.3 * h
        ba.t = (dragging and dragging()) and 1 or 0
        bubble.Visible = ba.x > 0.02
        if bubble.Visible then
            bubble.Position = UDim2.new(p, 0, 0, -2 - 6 * ba.x)
            bubbleScale.Scale = 0.6 + 0.4 * ba.x
            bubble.BackgroundTransparency = 1 - clamp01(ba.x)
            bubbleText.TextTransparency = 1 - clamp01(ba.x)
            bubbleText.Text = fmt(e.Value) .. suffix
        end
        fill.BackgroundColor3 = WHITE:Lerp(accent(), 0.35 + 0.65 * h)
    end)
    function e:Set(v, silent)
        v = tonumber(v) or self.Value
        v = min + math.floor((v - min) / inc + 0.5) * inc
        v = math.clamp(tonumber(fmt(v)) or v, min, max)
        local changed = v ~= self.Value
        self.Value = v
        vs.t = (v - min) / math.max(max - min, 1e-9)
        if not box:IsFocused() then box.Text = fmt(v) .. suffix end
        if changed and not silent then self:_fire(v) end
    end
    dragging = track(hit, function(pos)
        local rel = clamp01((pos.X - trk.AbsolutePosition.X) / math.max(trk.AbsoluteSize.X, 1))
        e:Set(min + rel * (max - min))
    end, function() hov.t = 0 end)
    box.Focused:Connect(function() box.Text = fmt(e.Value) tween(box, { TextColor3 = C.Text }, 0.15) end)
    box.FocusLost:Connect(function()
        tween(box, { TextColor3 = C.Sub }, 0.2)
        local n = tonumber((box.Text:gsub("[^%d%.%-]", "")))
        if n then e:Set(n) end
        box.Text = fmt(e.Value) .. suffix
    end)
    return e
end

-- ---- ドロップダウン (行がそのまま下へ開く。8 個以上で検索欄) ----
function Container:CreateDropdown(o)
