end

-- ---- 小さな黒いカプセル (島と同じ見た目。● 名前  60 fps  24 ms。ドラッグで動かせる) ----
function Window:CreateWatermark(o)
    o = o or {}
    local W = self
    local stats = o.Stats or { "fps", "ping" }
    local f = new("Frame", { Position = UDim2.fromOffset(16, 14), Size = UDim2.fromOffset(120, 28), BackgroundColor3 = rgb(4, 4, 6), BackgroundTransparency = 0.04, ZIndex = 55, Parent = W.Gui })
    corner(f, UDim.new(1, 0))
    local st = stroke(f, WHITE, 0.72)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.3, 0.95), Parent = st })
    local logo = new("ImageLabel", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 6, 0.5, 0), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = rgb(4, 4, 6), Image = W.Logo, ScaleType = Enum.ScaleType.Crop, ZIndex = 56, Parent = f })
    corner(logo, UDim.new(1, 0))
    -- 右の小さな点: fps が落ちると黄色 → 赤 (ふだんは緑)
    local dot = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -11, 0.5, 0), Size = UDim2.fromOffset(5, 5), BackgroundColor3 = Lib.Colors.green, ZIndex = 56, Parent = f })
    corner(dot, UDim.new(1, 0))
    local nameLb = text({ Position = UDim2.fromOffset(30, 0), Size = UDim2.new(0, 300, 1, 0), Text = "", FontFace = F.Bold, TextSize = 12, TextTruncate = Enum.TextTruncate.None, ZIndex = 56, Parent = f })
    local statLb = text({ Position = UDim2.fromOffset(30, 0), Size = UDim2.new(0, 300, 1, 0), Text = "", FontFace = F.Medium, TextSize = 12, TextColor3 = C.Muted, TextTruncate = Enum.TextTruncate.None, ZIndex = 56, Parent = f })
    local name = o.Text or W.Name
    local frames, fps, acc = 0, 60, 0
    local w = spring(120, 20, 0.9)
    local stop = onStep(function(dt)
        frames += 1
        acc += dt
        if acc >= 0.5 then fps = math.floor(frames / acc + 0.5) frames, acc = 0, 0 end
        -- 文字の幅に合わせて、カプセルがなめらかに伸び縮みする
        local nx = nameLb.TextBounds.X
        statLb.Position = UDim2.fromOffset(30 + nx + 10, 0)
        w.t = 30 + nx + (statLb.Text ~= "" and statLb.TextBounds.X + 10 or 0) + 26
        f.Size = UDim2.fromOffset(math.floor(w.x + 0.5), 28)
    end)
    task.spawn(function()
        while f.Parent and W.Alive do
            local parts = {}
            for _, s in ipairs(stats) do
                if s == "fps" then parts[#parts + 1] = fps .. " fps"
                elseif s == "ping" then
                    local ok, p = pcall(function() return LocalPlayer:GetNetworkPing() * 1000 end)
                    parts[#parts + 1] = (ok and math.floor(p + 0.5) or 0) .. " ms"
                elseif s == "time" then parts[#parts + 1] = os.date("%H:%M")
                end
            end
            nameLb.Text = name
            tween(dot, { BackgroundColor3 = fps >= 50 and Lib.Colors.green or fps >= 30 and Lib.Colors.yellow or Lib.Colors.red }, 0.4)
            statLb.Text = table.concat(parts, "  ")
            task.wait(0.5)
        end
        stop()
    end)
    -- ドラッグ
    local dragging, start, startPos
    f.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging, start, startPos = true, input.Position, f.Position
            tween(st, { Transparency = 0.4 }, 0.15)
        end
    end)
    conn(UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - start
            f.Position = UDim2.fromOffset(startPos.X.Offset + d.X, startPos.Y.Offset + d.Y)
        end
    end))
    conn(UserInputService.InputEnded:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            dragging = false
            tween(st, { Transparency = 0.72 }, 0.3)
        end
    end))
    local wm = { Frame = f }
    function wm:SetText(t) name = tostring(t) nameLb.Text = name end
    function wm:SetVisible(v) f.Visible = v ~= false end
    function wm:Destroy() f:Destroy() end
    return wm
end

