function Container:CreateInput(o)
    o = o or {}
    local R = baseRow(self, o, { rightScale = 0.45, right = 0 })
    local e = newElement(self, o, R, "Input")
    e.Value = tostring(o.CurrentValue or o.Default or "")
    local box = new("TextBox", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0, R.H0 / 2), Size = UDim2.new(0.45, -4, 0, 28),
        BackgroundColor3 = BLACK, BackgroundTransparency = 0.6, Text = e.Value, PlaceholderText = o.PlaceholderText or o.Placeholder or "",
        PlaceholderColor3 = C.Muted, ClearTextOnFocus = o.ClearTextOnFocus == true, FontFace = F.Medium, TextSize = 12,
        TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3, Parent = R.row,
    })
    corner(box, 9)
    local st = stroke(box, WHITE, 0.88, 1)
    new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 26), Parent = box })
    box.Focused:Connect(function() tween(st, { Color = accent(), Transparency = 0.3 }, 0.15) end)
    -- 文字がある時だけ、右に小さな消すボタン (iOS と同じ)
    local clear = new("ImageButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -15, 0, R.H0 / 2), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = C.Muted, BackgroundTransparency = 0.2, Image = "", AutoButtonColor = false, Visible = e.Value ~= "", ZIndex = 4, Parent = R.row })
    corner(clear, UDim.new(1, 0))
    local clearIc = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(10, 10), BackgroundTransparency = 1, ImageColor3 = rgb(20, 20, 24), ZIndex = 5, Parent = clear })
    setIcon(clearIc, "x")
    bounce(clear, nil, 1.12, 30, 0.8, 0.85)
    clear.MouseButton1Click:Connect(function()
        box.Text = ""
        e.Value = ""
        e:_fire("", false)
    end)
    box:GetPropertyChangedSignal("Text"):Connect(function() clear.Visible = box.Text ~= "" end)
    box:GetPropertyChangedSignal("Text"):Connect(function()
        local t = box.Text
        if o.Numeric then t = t:gsub("[^%d%.%-]", "") end
        if o.MaxLength and #t > o.MaxLength then t = t:sub(1, o.MaxLength) end
        if t ~= box.Text then box.Text = t return end
        if o.Live then e.Value = t e:_fire(t, false) end
    end)
    box.FocusLost:Connect(function(enter)
        tween(st, { Color = WHITE, Transparency = 0.88 }, 0.2)
        e.Value = box.Text
        e:_fire(box.Text, enter)
        if o.RemoveTextAfterFocusLost then box.Text = "" end
    end)
    function e:Set(t, silent)
        box.Text = tostring(t or "")
        self.Value = box.Text
        if not silent then self:_fire(self.Value, false) end
    end
    e.Box = box
    return e
end

-- ---- キーバインド ----
function Container:CreateKeybind(o)
    o = o or {}
    local W = self.Window
    local R = baseRow(self, o, { right = 90 })
    local e = newElement(self, o, R, "Keybind")
    e.Value = keyName(o.CurrentKeybind or o.Default or "None")
    local chip = new("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0, R.H0 / 2), Size = UDim2.fromOffset(0, 26),
        AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = WHITE, BackgroundTransparency = 0.92, Text = keyLabel(e.Value),
        FontFace = F.Bold, TextSize = 12, TextColor3 = C.Text, AutoButtonColor = false, ZIndex = 4, Parent = R.row,
    })
    corner(chip, 8)
    local cst = gstroke(chip, 0.8, 0.3, 0.9)
    new("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), Parent = chip })
    new("UISizeConstraint", { MinSize = Vector2.new(44, 26), Parent = chip })
    bounce(chip, nil, 1.05, 30, 0.86, 0.92)
    local listening = false
    local function setListening(on)
        listening = on
        -- 解除は 1 フレーム後 (登録したキーで、同じ瞬間に UI の表示切替などが動かないように)
        if on then Lib._listening = true else task.defer(function() if not listening then Lib._listening = false end end) end
        chip.Text = on and "···" or keyLabel(e.Value)
        tween(chip, { BackgroundTransparency = on and 0.8 or 0.92 }, 0.15)
        tween(cst, { Color = on and accent() or WHITE, Transparency = on and 0.2 or 0.8 }, 0.15)
    end
    chip.MouseButton1Click:Connect(function() if not e.Locked then setListening(not listening) end end)
    function e:Set(k)
        self.Value = keyName(k)
        chip.Text = keyLabel(self.Value)
        call(o.ChangedCallback, self.Value)
        self:_notify(self.Value)
    end
    conn(UserInputService.InputBegan:Connect(function(input, processed)
        if not W.Alive then return end
        if listening then
            local k
            if input.UserInputType == Enum.UserInputType.Keyboard then
                if input.KeyCode == Enum.KeyCode.Escape then setListening(false) return end
                k = (input.KeyCode == Enum.KeyCode.Backspace or input.KeyCode == Enum.KeyCode.Delete) and "None" or input.KeyCode.Name
            elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.MouseButton3 then
                k = input.UserInputType.Name
            end
            if k then
                setListening(false)
                e:Set(k)
            end
            return
        end
        if processed or e.Locked or UserInputService:GetFocusedTextBox() then return end
        if keyMatch(input, e.Value) then
            chip.BackgroundTransparency = 0.7
            tween(chip, { BackgroundTransparency = 0.92 }, 0.4)
            if o.HoldToInteract then call(o.Callback, true) else call(o.Callback) end
        end
    end))
    if o.HoldToInteract then
        conn(UserInputService.InputEnded:Connect(function(input)
            if W.Alive and not listening and keyMatch(input, e.Value) then call(o.Callback, false) end
        end))
    end
    return e
end

-- ---- 色 (行がそのまま開いて、色の四角・色相・HEX・よく使う色) ----
function Container:CreateColorPicker(o)
    o = o or {}
    local R = baseRow(self, o, { right = 60, clip = true })
    local e = newElement(self, o, R, "ColorPicker")
    local H0 = R.H0
    local c0 = o.Color or o.Default or accent()
    local h, s, v = c0:ToHSV()
    e.Value = c0
    -- iOS の色のボタン: 虹色の輪の中に、今の色の丸
    local keys = {}
    for i = 0, 6 do keys[#keys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.75, 1)) end
    local well = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, H0 / 2), Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 1, ZIndex = 2, Parent = R.row })
    corner(well, UDim.new(1, 0))
    local ring = stroke(well, WHITE, 0, 2.5)
    local ringGrad = new("UIGradient", { Color = ColorSequence.new(keys), Parent = ring })
    local sw = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(17, 17), BackgroundColor3 = c0, ZIndex = 3, Parent = well })
    corner(sw, UDim.new(1, 0))
    local wellScale = new("UIScale", { Parent = well })
    local hit = new("TextButton", { Size = UDim2.new(1, 0, 0, H0), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = R.row })
    bounce(hit, well, 1.08, 30, 0.8, 0.9)
    wellScale.Scale = 1

    -- 開いた中身: 閉じている時は CanvasGroup ごと消す (縁取りが行の外へはみ出さない)
    local body = new("CanvasGroup", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, Visible = false, ZIndex = 3, Parent = R.row })
    local SVH = 110
    local sv = new("Frame", { Position = UDim2.fromOffset(12, H0 + 4), Size = UDim2.new(1, -54, 0, SVH), BackgroundColor3 = Color3.fromHSV(h, 1, 1), ZIndex = 3, Parent = body })
    corner(sv, 10)
    local wl = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Parent = sv })
    corner(wl, 10)
    new("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = wl })
    local bl = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0, ZIndex = 3, Parent = sv })
    corner(bl, 10)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = bl })
    local cur = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = c0, ZIndex = 4, Parent = sv })
    corner(cur, UDim.new(1, 0))
    stroke(cur, WHITE, 0, 2)
    local svHit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = sv })

    local hue = new("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, H0 + 4), Size = UDim2.fromOffset(18, SVH), BackgroundColor3 = WHITE, ZIndex = 3, Parent = body })
    corner(hue, 9)
    local hkeys = {}
    for i = 0, 6 do hkeys[#hkeys + 1] = ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 1, 1)) end
    new("UIGradient", { Rotation = 90, Color = ColorSequence.new(hkeys), Parent = hue })
    local hcur = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1, 6, 0, 6), BackgroundColor3 = WHITE, ZIndex = 4, Parent = hue })
    corner(hcur, UDim.new(1, 0))
    stroke(hcur, BLACK, 0.6, 1)
    local hueHit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 5, Parent = hue })

    local hex = new("TextBox", {
        Position = UDim2.fromOffset(12, H0 + SVH + 12), Size = UDim2.fromOffset(92, 26), BackgroundColor3 = BLACK, BackgroundTransparency = 0.6,
        Text = "", FontFace = F.Bold, TextSize = 12, TextColor3 = C.Text, ClearTextOnFocus = false, ZIndex = 3, Parent = body,
    })
    corner(hex, 8)
    stroke(hex, WHITE, 0.88, 1)
    local presets = new("Frame", { Position = UDim2.fromOffset(114, H0 + SVH + 12), Size = UDim2.new(1, -126, 0, 26), BackgroundTransparency = 1, ClipsDescendants = true, ZIndex = 3, Parent = body })
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6), Parent = presets })

    local function paint(skipHex)
        local c = Color3.fromHSV(h, s, v)
        e.Value = c
        sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        cur.Position = UDim2.fromScale(s, 1 - v)
        cur.BackgroundColor3 = c
        hcur.Position = UDim2.new(0.5, 0, h, 0)
        sw.BackgroundColor3 = c
        if not skipHex then hex.Text = "#" .. string.upper(c:ToHex()) end
    end
    function e:Set(c, silent)
        if typeof(c) ~= "Color3" then return end
        h, s, v = c:ToHSV()
        paint()
        if not silent then self:_fire(self.Value) end
    end
    function e:SetColor(c) self:Set(c) end
    for i, pc in ipairs({ Lib.Colors.red, Lib.Colors.orange, Lib.Colors.yellow, Lib.Colors.green, Lib.Colors.teal, Lib.Colors.blue, Lib.Colors.indigo, Lib.Colors.purple, Lib.Colors.pink, WHITE }) do
        local b = new("TextButton", { Size = UDim2.fromOffset(18, 18), BackgroundColor3 = pc, Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 4, Parent = presets })
        corner(b, UDim.new(1, 0))
        stroke(b, WHITE, 0.75, 1)
        bounce(b, nil, 1.15, 32, 0.86, 0.9)
        b.MouseButton1Click:Connect(function() e:Set(pc) end)
    end
    track(svHit, function(pos)
        s = clamp01((pos.X - sv.AbsolutePosition.X) / math.max(sv.AbsoluteSize.X, 1))
        v = 1 - clamp01((pos.Y - sv.AbsolutePosition.Y) / math.max(sv.AbsoluteSize.Y, 1))
        paint()
        e:_fire(e.Value)
    end)
    track(hueHit, function(pos)
        h = math.min(clamp01((pos.Y - hue.AbsolutePosition.Y) / math.max(hue.AbsoluteSize.Y, 1)), 0.9999)
        paint()
        e:_fire(e.Value)
    end)
    hex.FocusLost:Connect(function()
        local str = hex.Text:gsub("#", ""):gsub("%s", "")
        local ok, c = pcall(Color3.fromHex, str)
        if ok and c then e:Set(c) else paint() end
    end)
    local open = false
    local hs = heightSpring(R.row, H0)
    local FULL = H0 + SVH + 50
    onStep(function()
        local p = clamp01((hs.x - H0) / (FULL - H0))
        body.Visible = p > 0.01
        body.GroupTransparency = 1 - p * p
        ringGrad.Rotation = (os.clock() * (open and 90 or 25)) % 360 -- 輪はゆっくり回る (開いている間は少し速く)
    end)
    hit.MouseButton1Click:Connect(function()
        open = not open
        hs.t = open and FULL or H0
    end)
    paint()
    return e
end

-- ---- セグメント (選んだ所へガラスの玉が液体のように伸びながら滑る) ----
function Container:CreateSegment(o)
    o = o or {}
    local R = baseRow(self, o, { stacked = true, extra = 40 })
    local e = newElement(self, o, R, "Segment")
    local opts = o.Options or {}
    local n = math.max(#opts, 1)
    local bar = new("Frame", { Position = UDim2.fromOffset(10, R.H0), Size = UDim2.new(1, -20, 0, 30), BackgroundColor3 = BLACK, BackgroundTransparency = 0.6, ZIndex = 2, Parent = R.row })
    corner(bar, UDim.new(1, 0))
    stroke(bar, WHITE, 0.9, 1)
    local pill = new("Frame", { BackgroundColor3 = WHITE, BackgroundTransparency = 0.82, ZIndex = 3, Parent = bar })
    corner(pill, UDim.new(1, 0))
    gstroke(pill, 0.5, 0.15, 0.8)
    local function indexOf(v) for i, x in ipairs(opts) do if x == v then return i end end return 1 end
    e.Value = o.CurrentOption or o.Default or opts[1]
    if type(e.Value) == "table" then e.Value = e.Value[1] end
    local i0 = indexOf(e.Value)
    local l, r = spring(i0 - 1, 24, 0.86), spring(i0, 24, 0.86)
    local labels = {}
    for i, opt in ipairs(opts) do
        local b = new("TextButton", {
            Position = UDim2.new((i - 1) / n, 0, 0, 0), Size = UDim2.new(1 / n, 0, 1, 0), BackgroundTransparency = 1,
            Text = tostring(opt), FontFace = F.Bold, TextSize = 12, TextColor3 = C.Sub, ZIndex = 4, Parent = bar,
        })
        labels[i] = b
        b.MouseEnter:Connect(function() if e.Value ~= opt then tween(b, { TextColor3 = C.Text }, 0.12) end end)
        b.MouseLeave:Connect(function() if e.Value ~= opt then tween(b, { TextColor3 = C.Sub }, 0.18) end end)
        b.MouseButton1Click:Connect(function() PressedAt = os.clock() e:Set(opt) end)
    end
    onStep(function()
        pill.Position = UDim2.new(l.x / n, 2, 0, 2)
        pill.Size = UDim2.new((r.x - l.x) / n, -4, 1, -4)
    end)
    local function paint()
        for i, opt in ipairs(opts) do tween(labels[i], { TextColor3 = e.Value == opt and C.Text or C.Sub }, 0.15) end
    end
    function e:Set(v, silent)
        local i = indexOf(v)
        local from = l.t + 1
        self.Value = opts[i]
        -- 進む側の端を先に、後ろの端を遅れて動かす → 伸びて縮む
        if i > from then r.w, l.w = 34, 17 elseif i < from then r.w, l.w = 17, 34 end
        l.t, r.t = i - 1, i
        paint()
        if not silent then self:_fire(self.Value) end
    end
    paint()
    return e
end

-- ---- ステッパー (- 値 +。押しっぱなしで連続) ----
function Container:CreateStepper(o)
    o = o or {}
    local R = baseRow(self, o, { right = 122 })
    local e = newElement(self, o, R, "Stepper")
    local min, max, step = o.Min or 0, o.Max or 100, o.Step or o.Increment or 1
    local dec = step < 1 and math.max(0, math.ceil(-math.log10(step) - 1e-9)) or 0
    local suffix = o.Suffix and tostring(o.Suffix) or ""
    e.Value = math.clamp(o.CurrentValue or o.Default or min, min, max)
    local val = text({
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -42, 0, R.H0 / 2), Size = UDim2.fromOffset(46, 20),
        Text = "", FontFace = F.Bold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3, Parent = R.row,
    })
    local vscale = new("UIScale", { Parent = val })
    local pulse = spring(1, 30, 0.6)
    onStep(function() vscale.Scale = pulse.x end)
    local function show() val.Text = string.format("%." .. dec .. "f", e.Value) .. suffix end
    function e:Set(v, silent)
        v = math.clamp(tonumber(v) or self.Value, min, max)
        v = tonumber(string.format("%." .. dec .. "f", v)) or v
        if v == self.Value then return end
        self.Value = v
        show()
        pulse.x = 1.18
        if not silent then self:_fire(v) end
    end
    for _, d in ipairs({ { "minus", -step, -90 }, { "plus", step, -10 } }) do
        local b = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, d[3], 0, R.H0 / 2), Size = UDim2.fromOffset(30, 26),
            BackgroundColor3 = WHITE, BackgroundTransparency = 0.92, Text = "", AutoButtonColor = false, ZIndex = 4, Parent = R.row,
        })
        corner(b, 8)
        gstroke(b, 0.8, 0.3, 0.9)
        local ic = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ImageColor3 = C.Text, ZIndex = 5, Parent = b })
        setIcon(ic, d[1])
        bounce(b, nil, 1.06, 30, 0.86, 0.9)
        local held, tok = false, 0
        b.MouseButton1Down:Connect(function()
            if e.Locked then return end
            held = true
            tok += 1
            local my = tok
            e:Set(e.Value + d[2])
            task.delay(0.4, function()
                while held and tok == my do e:Set(e.Value + d[2]) task.wait(0.06) end
            end)
        end)
        b.MouseButton1Up:Connect(function() held = false end)
        b.MouseLeave:Connect(function() held = false end)
    end
    show()
    return e
end

-- ---- 進み具合 (光がゆっくり流れるバー) ----
function Container:CreateProgress(o)
    o = o or {}
    local R = baseRow(self, o, { stacked = true, extra = 18, right = 50 })
    local e = newElement(self, o, R, "Progress")
    local start = o.CurrentValue or o.Default or 0
    e.Value = clamp01(o.Max and start / o.Max or start)
    local pct = text({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0, R.H0 / 2), Size = UDim2.fromOffset(48, 18), Text = "", FontFace = F.Bold, TextSize = 12, TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 2, Parent = R.row })
    local trk = new("Frame", { Position = UDim2.fromOffset(14, R.H0 + 2), Size = UDim2.new(1, -28, 0, 6), BackgroundColor3 = WHITE, BackgroundTransparency = 0.86, BorderSizePixel = 0, ZIndex = 2, Parent = R.row })
    corner(trk, UDim.new(1, 0))
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = accent(), BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 2, Parent = trk })
    corner(fill, UDim.new(1, 0))
    local shine = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 3, Parent = fill })
    corner(shine, UDim.new(1, 0))
    local sg = new("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.6), NumberSequenceKeypoint.new(1, 1) }), Parent = shine })
    local custom
    onAccent(function(a) if not custom then fill.BackgroundColor3 = a end end)
    local ps = spring(e.Value, 14, 1)
    onStep(function()
        fill.Size = UDim2.fromScale(clamp01(ps.x), 1)
        sg.Offset = Vector2.new((os.clock() * 0.6) % 2 - 1, 0)
    end)
    function e:Set(p, silent)
        p = tonumber(p) or 0
        if o.Max then p = p / o.Max end
        self.Value = clamp01(p)
        ps.t = self.Value
        pct.Text = math.floor(self.Value * 100 + 0.5) .. "%"
        if not silent then self:_notify(self.Value) end
    end
    function e:SetColor(c) custom = c fill.BackgroundColor3 = c end
    e:Set(start, true)
    return e
end

-- ---- 色の丸 (いくつかの色から 1 つ) ----
function Container:CreateSwatches(o)
    o = o or {}
    local colors = o.Colors or {}
    local R = baseRow(self, o, { right = #colors * 26 + 6 })
    local e = newElement(self, o, R, "Swatches")
    e.Index = o.Current or 1
    e.Value = colors[e.Index]
    local holder = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0, R.H0 / 2), Size = UDim2.fromOffset(#colors * 26, 24), BackgroundTransparency = 1, ZIndex = 3, Parent = R.row })
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 4), Parent = holder })
    local rings = {}
    for i, c in ipairs(colors) do
        local b = new("TextButton", { Size = UDim2.fromOffset(22, 22), BackgroundColor3 = c, Text = "", AutoButtonColor = false, LayoutOrder = i, ZIndex = 4, Parent = holder })
        corner(b, UDim.new(1, 0))
        rings[i] = stroke(b, WHITE, i == e.Index and 0 or 1, 2)
        bounce(b, nil, 1.12, 32, 0.86, 0.9)
        b.MouseButton1Click:Connect(function() e:Set(i) end)
    end
    function e:Set(i, silent)
        if typeof(i) == "Color3" then
            for k, c in ipairs(colors) do if c == i then i = k break end end
            if typeof(i) == "Color3" then return end
        end
        if not colors[i] then return end
        self.Index, self.Value = i, colors[i]
        for k, r in ipairs(rings) do tween(r, { Transparency = k == i and 0 or 1 }, 0.2) end
        if not silent then self:_fire(self.Value, i) end
    end
    return e
end

-- ---- 文章 ----
function Container:CreateParagraph(o)
    if type(o) ~= "table" then o = { Content = o } end
    local r, _, card = self:_cardRow(0, 14, true)
    local inner = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, ZIndex = 2, Parent = r })
    new("UIPadding", { PaddingTop = UDim.new(0, 10), PaddingBottom = UDim.new(0, 11), PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), Parent = inner })
    new("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder, Parent = inner })
    local title = text({ Size = UDim2.new(1, 0, 0, 18), Text = tostring(o.Title or ""), FontFace = F.Bold, TextSize = 13, LayoutOrder = 1, Visible = (o.Title or "") ~= "", ZIndex = 2, Parent = inner })
    local body = text({ Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Text = tostring(o.Content or ""), TextSize = 12, TextColor3 = C.Sub, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextYAlignment = Enum.TextYAlignment.Top, LayoutOrder = 2, ZIndex = 2, Parent = inner })
    local e = newElement(self, { Name = (o.Title or "") .. " " .. (o.Content or "") }, { row = r, card = card, H0 = 40 }, "Paragraph")
    function e:Set(a)
        if type(a) == "table" then
            if a.Title then title.Text = a.Title title.Visible = a.Title ~= "" end
            if a.Content then body.Text = a.Content end
        else
            body.Text = tostring(a)
