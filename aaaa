function Window:Dialog(o)
    o = o or {}
    local W = self
    local WIDTH = 300
    local content = tostring(o.Content or "")
    local th = content ~= "" and textHeight(content, 12, WIDTH - 40) or 0
    local hasIcon = o.Icon ~= nil
    local top = hasIcon and 70 or 22
    local h = top + 24 + (th > 0 and th + 8 or 0) + 16 + 34 + 16
    local overlay = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 40, Parent = W.Sheet })
    corner(overlay, 26)
    tween(overlay, { BackgroundTransparency = 0.45 }, 0.3)
    local holder = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(WIDTH, h), BackgroundTransparency = 1, ZIndex = 41, Parent = overlay })
    local p = pop(holder, { from = 0.86, dy = 14, speed = 24, damp = 0.8 })
    local card = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = p.body })
    local g = glass(card, 22)
    if hasIcon then
        local c = o.IconColor or accent()
        local sq = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 18), Size = UDim2.fromOffset(42, 42), BackgroundColor3 = c, ZIndex = 2, Parent = card })
        corner(sq, 13)
        new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, rgb(200, 200, 212)), Parent = sq })
        gstroke(sq, 0.6, 0.1, 0.9)
        local ic = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 1, ImageColor3 = contrast(c), ZIndex = 3, Parent = sq })
        setIcon(ic, o.Icon)
    end
    text({ Position = UDim2.fromOffset(20, top), Size = UDim2.new(1, -40, 0, 22), Text = tostring(o.Title or ""), FontFace = F.Heavy, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2, Parent = card })
    if th > 0 then
        text({ Position = UDim2.fromOffset(20, top + 28), Size = UDim2.new(1, -40, 0, th), Text = content, TextSize = 12, TextColor3 = C.Sub, TextWrapped = true, TextTruncate = Enum.TextTruncate.None, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 2, Parent = card })
    end
    local buttons = o.Buttons or { { Title = "OK", Variant = "Primary" } }
    local n = #buttons
    local row = new("Frame", { Position = UDim2.new(0, 16, 1, -50), Size = UDim2.new(1, -32, 0, 34), BackgroundTransparency = 1, ZIndex = 2, Parent = card })
    new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = row })
    local closed = false
    local function close()
        if closed then return end
        closed = true
        if W._dialogClose == close then W._dialogClose = nil end
        p:Set(false)
        tween(overlay, { BackgroundTransparency = 1 }, 0.3)
        task.delay(0.45, function()
            p.stop()
            unspring(p.spring)
            Glasses[g] = nil
            overlay:Destroy()
        end)
    end
    for i, b in ipairs(buttons) do
        local primary, danger = b.Variant == "Primary", b.Variant == "Danger"
        local btn = new("TextButton", {
            Size = UDim2.new(1 / n, -(8 * (n - 1)) / n, 1, 0), Text = tostring(b.Title or b.Name or "OK"), FontFace = F.Bold,
            TextSize = 13, TextColor3 = C.Text, AutoButtonColor = false, LayoutOrder = i, ZIndex = 3, Parent = row,
        })
        makeGlassButton(btn, primary or danger)
        if primary then
            onAccent(function(a) btn.BackgroundColor3 = a btn.TextColor3 = contrast(a) end)
        elseif danger then
            btn.BackgroundColor3 = Lib.Colors.red
            btn.TextColor3 = WHITE
        end
        btn.MouseButton1Click:Connect(function() close() call(b.Callback) end)
    end
    W._dialogClose = close
    p:Set(true)
    return { Close = close }
end

