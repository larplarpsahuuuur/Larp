        if n == nil or n == false or n == 0 then bs.t = 0 return end
        if n == true then
            badgeText.Text = ""
            badge.Size = UDim2.fromOffset(10, 10)
            badgeMin.MinSize = Vector2.new(10, 10)
        else
            badgeText.Text = (tonumber(n) or 0) > 99 and "99+" or tostring(n)
            badge.Size = UDim2.fromOffset(16, 16)
            badgeMin.MinSize = Vector2.new(16, 16)
        end
        bs.x = bs.t > 0 and 1.3 or bs.x -- 増えた時もぷるっと
        bs.t = 1
    end
    table.insert(W.Tabs, T)
    W.OrnH = #W.Tabs * 44 + 8 + W.LogoH
    if not W.Current then W:SelectTab(T, true) end
    return T
end

function Window:SelectTab(t, instant)
    if type(t) == "string" then
        for _, x in ipairs(self.Tabs) do if x.Name == t then t = x break end end
    elseif type(t) == "number" then
        t = self.Tabs[t]
    end
    if type(t) ~= "table" or self.Current == t then return end
    local prev = self.Current
    self.Current = t
    local down = not prev or t.Index > prev.Index
    -- ページは縦に滑る: 下のタブへ行く時は下から入って、前のページは上へ抜ける
    t.Pop.dy = down and 22 or -22
    if prev then prev.Pop.dy = down and -22 or 22 end
    local on = contrast(accent())
    for _, x in ipairs(self.Tabs) do
        local sel = x == t
        x.Pop:Set(sel)
        if sel and instant then x.Pop:Snap(true) end
        tween(x._icon, { ImageColor3 = sel and on or C.Sub }, 0.22)
        tween(x._label, { TextColor3 = sel and on or C.Sub }, 0.22)
    end
    if not self._accentHooked then
        self._accentHooked = true
        onAccent(function(a)
            if self.Current then
                self.Current._icon.ImageColor3 = contrast(a)
                self.Current._label.TextColor3 = contrast(a)
            end
        end)
    end
    -- 印は液体のように: 進む側の端が先に伸び、後ろの端が追いつく
    local top = (t.Index - 1) * 44
    self.IndTop.w, self.IndBot.w = down and 15 or 30, down and 30 or 15
    self.IndTop.t, self.IndBot.t = top, top + 40
    if instant then self.IndTop.x, self.IndBot.x = top, top + 40 end
    -- 見出し: 下から浮かんでくる
    local hasDesc = t.Desc ~= nil and t.Desc ~= ""
    local ty = hasDesc and 16 or 24
    self.TitleLabel.Text = t.Name
    self.DescLabel.Text = t.Desc or ""
    self.TitleLabel.TextTransparency, self.DescLabel.TextTransparency = 1, 1
    self.TitleLabel.Position = UDim2.fromOffset(22, ty + (down and 8 or -8))
    if not self._searching then
        tween(self.TitleLabel, { TextTransparency = 0, Position = UDim2.fromOffset(22, ty) }, 0.5)
        tween(self.DescLabel, { TextTransparency = 0 }, 0.55)
    end
    if self.SearchBox and self.SearchBox.Text ~= "" then self.SearchBox.Text = "" end
    for _, fn in ipairs(self._tabHooks or {}) do call(fn, t, prev) end
end
-- タブが変わった時: fn(新しいタブ, 前のタブ)
function Window:OnTabChanged(fn)
    self._tabHooks = self._tabHooks or {}
    table.insert(self._tabHooks, fn)
end

-- ---- 表示 ----
function Window:SetVisible(v)
    if not self.Alive then return end
    self.Visible = v and true or false
    self.Pop:Set(self.Visible)
    if self._ox then
        if self.Visible then
            self._ox.x, self._ox.v = 0, 0
            task.delay(0.07, function() if self.Visible then self._ox.t = 1 end end)
        else
            self._ox.t = 0
        end
    end
    if self.OpenButton then
        self.Island:Rest(not self.Visible)
    elseif not self.Visible then
        self.Island:Flash(self.Name, keyLabel(self.ToggleKey) .. " to reopen", 2.2)
    end
end
function Window:Toggle() self:SetVisible(not self.Visible) end
function Window:SetScale(i)
    if not SCALES[i] then return end
    self.ScaleIndex = i
    tween(self.RootScale, { Scale = SCALES[i] * self:_fit() }, 0.35)
end
function Window:SetBlur(on) self.Blur = on and true or false end
-- 上の島に少しだけ出す (W.Island は島そのもの)
function Window:Flash(main, sub, duration, icon, color) self.Island:Flash(main, sub, duration, icon, color) end

function Window:Destroy(instant)
    if not self.Alive then return end
    self.Alive = false
    self.Pop:Set(false)
    self.Island:Hide()
    local gui, blur = self.Gui, self._blur
    task.delay(instant and 0 or 0.45, function()
        pcall(function() gui:Destroy() end)
        if blur then pcall(function() blur:Destroy() end) end
    end)
    for flag, e in pairs(self.Flags) do if Lib.Flags[flag] == e then Lib.Flags[flag] = nil end end
    local i = table.find(Lib.Windows, self)
    if i then table.remove(Lib.Windows, i) end
end
Window.Unload = Window.Destroy

