-- Dynamic Island (画面の上の黒い島)
-- ===================================================================
local function makeIsland(W)
    local I = { mode = "", rest = false }
    local holder = new("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 10), Size = UDim2.fromOffset(160, 38), BackgroundTransparency = 1, ZIndex = 50, Parent = W.Gui })
    local p = pop(holder, { from = 0.8, dy = -12, speed = 22, damp = 0.8 })
    local pill = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(4, 4, 6), BackgroundTransparency = 0.02, ClipsDescendants = true, Parent = p.body })
    local pc = corner(pill, 19)
    local pst = stroke(pill, WHITE, 0.7)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(0.3, 0.95), Parent = pst })
    local dot = new("Frame", { Position = UDim2.fromOffset(6, 6), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = accent(), Parent = pill })
    corner(dot, UDim.new(1, 0))
    new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, rgb(200, 200, 212)), Parent = dot })
    local dotIcon = new("ImageLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ImageColor3 = WHITE, Parent = dot })
    -- ロゴ (アイコンの指定が無い時はこれを出す)
    local dotLogo = new("ImageLabel", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(4, 4, 6), Image = W.Logo, ScaleType = Enum.ScaleType.Crop, ZIndex = 2, Parent = dot })
    corner(dotLogo, UDim.new(1, 0))
    local dotScale = new("UIScale", { Parent = dot })
    local dotPop = spring(1, 26, 0.6)
    onStep(function() dotScale.Scale = dotPop.x end)
    local label = text({ Position = UDim2.fromOffset(40, 0), Size = UDim2.new(0, 400, 0, 38), Text = "", FontFace = F.Bold, TextSize = 14, Parent = pill })
    local sub = text({ Position = UDim2.fromOffset(40, 9), Size = UDim2.new(0, 400, 0, 38), Text = "", TextSize = 12, TextColor3 = C.Sub, TextTransparency = 1, Parent = pill })
    local right = text({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0), Size = UDim2.fromOffset(44, 38), Text = "", FontFace = F.Bold, TextSize = 12, TextColor3 = C.Sub, TextXAlignment = Enum.TextXAlignment.Right, Parent = pill })
    local wave = new("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0, 19), Size = UDim2.fromOffset(16, 14), BackgroundTransparency = 1, Parent = pill })
    local bars = {}
    for i = 1, 4 do
        local b = new("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, (i - 1) * 4, 0.5, 0), Size = UDim2.new(0, 2, 0.3, 0), BackgroundColor3 = WHITE, BackgroundTransparency = 0.25, BorderSizePixel = 0, Parent = wave })
        corner(b, UDim.new(1, 0))
        bars[i] = b
    end
    local barTrack = new("Frame", { Position = UDim2.fromOffset(14, 46), Size = UDim2.new(1, -28, 0, 4), BackgroundColor3 = WHITE, BackgroundTransparency = 0.85, BorderSizePixel = 0, Parent = pill })
    corner(barTrack, UDim.new(1, 0))
    local barFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = accent(), BorderSizePixel = 0, Parent = barTrack })
    corner(barFill, UDim.new(1, 0))
    local hit = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 5, Parent = pill })
    local w, hh = spring(160, 15, 0.84), spring(38, 15, 0.84)
    local prog = spring(0, 12, 1)
    local customDot = false
    onAccent(function(a)
        barFill.BackgroundColor3 = a
        if not customDot then dot.BackgroundColor3 = a dotIcon.ImageColor3 = contrast(a) end
    end)

    local function setText(main, subText)
        -- 前の文字は上へ抜けて消え、新しい文字は少し下から浮かんでくる
        local y = subText and subText ~= "" and -7 or 0
        tween(label, { TextTransparency = 1, Position = UDim2.fromOffset(40, label.Position.Y.Offset - 6) }, 0.16, Enum.EasingStyle.Sine)
        tween(sub, { TextTransparency = 1 }, 0.16)
        task.delay(0.16, function()
            label.Text = main or ""
            sub.Text = subText or ""
            label.Position = UDim2.fromOffset(40, y + 8)
            sub.Position = UDim2.fromOffset(40, 17)
            tween(label, { TextTransparency = 0, Position = UDim2.fromOffset(40, y) }, 0.55)
            tween(sub, { TextTransparency = (subText and subText ~= "") and 0 or 1, Position = UDim2.fromOffset(40, 9) }, 0.6)
        end)
    end
    -- 丸の中身を変える (変わる時にぷるっと弾む)。icon も color も無ければロゴ
    local function setDot(icon, color)
        local logo = icon == nil and color == nil and W.Logo ~= ""
        dotLogo.Visible = logo
        customDot = color ~= nil
        local c = color or accent()
        tween(dot, { BackgroundColor3 = c }, 0.25)
        dotIcon.ImageColor3 = contrast(c)
        if not logo then setIcon(dotIcon, icon or W.Icon) end
        dotPop.x = 0.6
    end
    local token = 0
    local function settle()
        if I.mode == "loading" then return end
        if I.rest then
            if I.mode ~= "rest" then
                setText(W.Name, keyLabel(W.ToggleKey) .. "  ·  tap to open")
                setDot()
            end
            I.mode = "rest"
            right.Text = ""
            p:Set(true)
        else
            I.mode = ""
            p:Set(false)
        end
    end
    function I:Flash(main, subText, duration, icon, color)
        if I.mode == "loading" then return end
        token += 1
        local my = token
        I.mode = "flash"
        right.Text = ""
        p:Set(true)
        setText(main, subText)
        setDot(icon, color)
        task.delay(duration or 2.5, function()
            if token == my and I.mode == "flash" then I.mode = "_" settle() end
        end)
    end
    function I:Rest(on)
        I.rest = on and true or false
        if I.mode ~= "flash" and I.mode ~= "loading" then
            if I.mode == "rest" and not I.rest then I.mode = "_" end
            settle()
        end
    end
    function I:Loading(title)
        I.mode = "loading"
        p:Set(true)
        setText(title, "")
        setDot()
        prog.x, prog.v, prog.t = 0, 0, 0
        local last
        return {
            Set = function(pct, step)
                prog.t = pct
                right.Text = math.floor(pct * 100 + 0.5) .. "%"
                if step and step ~= last then last = step setText(title, step) end
            end,
            Done = function(txt)
                prog.t = 1
                right.Text = ""
                setDot("check", Lib.Colors.green)
                setText(title, txt)
            end,
        }
    end
    function I:EndLoading() I.mode = "_" settle() end
    function I:Hide() token += 1 I.rest = false I.mode = "_" settle() end

    hit.MouseButton1Click:Connect(function() if I.mode == "rest" then W:SetVisible(true) end end)
    hit.MouseEnter:Connect(function() tween(pst, { Transparency = 0.35 }, 0.2) end)
    hit.MouseLeave:Connect(function() tween(pst, { Transparency = 0.7 }, 0.3) end)
    onStep(function()
        local need = math.max(label.TextBounds.X, sub.Text ~= "" and sub.TextBounds.X or 0)
        if I.mode == "loading" then
            w.t = math.max(300, need + 40 + 64)
            hh.t = 60
        else
            w.t = math.clamp(need + 40 + 46, 140, 460)
            hh.t = 38
        end
        holder.Size = UDim2.fromOffset(math.floor(w.x + 0.5), math.floor(hh.x + 0.5))
        pc.CornerRadius = UDim.new(0, math.min(hh.x / 2, 24))
        barFill.Size = UDim2.fromScale(clamp01(prog.x), 1)
        wave.Visible = right.Text == "" and I.mode ~= "loading"
        if wave.Visible and holder.Visible then
            local t = os.clock()
            for i, b in ipairs(bars) do b.Size = UDim2.new(0, 2, 0.3 + 0.7 * math.abs(math.sin(t * (2.4 + i * 0.6) + i)), 0) end
        end
    end)
    return I
end

