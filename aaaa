    local function dragHandle(f)
        f.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                local start = Vector2.new(input.Position.X, input.Position.Y)
                task.defer(function()
                    if os.clock() - PressedAt < 0.1 then return end
                    W._drag = { start = start, base = Vector2.new(posX.t, posY.t) }
                end)
            end
        end)
    end
    dragHandle(headDrag)
    conn(UserInputService.InputChanged:Connect(function(input)
        local d = W._drag
        if d and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = (Vector2.new(input.Position.X, input.Position.Y) - d.start)
            posX.t, posY.t = d.base.X + delta.X, d.base.Y + delta.Y
        end
    end))
    conn(UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then W._drag = nil end
