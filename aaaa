            Text = "", PlaceholderText = "search", PlaceholderColor3 = C.Muted, ClearTextOnFocus = false, FontFace = F.Medium,
            TextSize = 12, TextColor3 = C.Text, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 3, Parent = body,
        })
