    local lb = text({ Position = UDim2.fromOffset(42, 0), Size = UDim2.new(1, -48, 1, 0), Text = tostring(o.Name or "Tab"), FontFace = F.Bold, TextSize = 13, TextColor3 = C.Sub, TextTransparency = 1, ZIndex = 14, Parent = btn })
    bounce(btn, nil, 1.04, 30, 0.86, 0.92)
    -- バッジ (アイコンの右上の赤い数字。T:SetBadge(3) / T:SetBadge(true) で点 / nil で消す)
    local badge = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(29, 10), Size = UDim2.fromOffset(16, 16), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Lib.Colors.red, ZIndex = 15, Parent = btn })
    corner(badge, UDim.new(1, 0))
    stroke(badge, rgb(9, 9, 12), 0, 2)
    local badgeMin = new("UISizeConstraint", { MinSize = Vector2.new(16, 16), Parent = badge })
    local badgeText = text({ Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X, Text = "", FontFace = F.Heavy, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.None, ZIndex = 16, Parent = badge })
    new("UIPadding", { PaddingLeft = UDim.new(0, 4), PaddingRight = UDim.new(0, 4), Parent = badgeText })
    local badgeScale = new("UIScale", { Scale = 0, Parent = badge })
    local bs = spring(0, 26, 0.6)
    onStep(function() badgeScale.Scale = math.max(bs.x, 0) badge.Visible = bs.x > 0.01 end)

    local holder = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = W.Pages })
    local pp = pop(holder, { from = 0.97, dy = 18, speed = 22, damp = 0.88 })
    local scroll = new("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 2,
        ScrollBarImageColor3 = WHITE, ScrollBarImageTransparency = 0.8, CanvasSize = UDim2.new(),
        AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y, Parent = pp.body,
    })
    local layout = new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = scroll })
    new("UIPadding", { PaddingLeft = UDim.new(0, 14), PaddingRight = UDim.new(0, 14), PaddingBottom = UDim.new(0, 14), Parent = scroll })
    local page = { items = {}, sections = {}, cards = {}, scroll = scroll, order = 0 }
    local T = newContainer(W, page, scroll, {
        IsTab = true, Name = tostring(o.Name or "Tab"), Desc = o.Desc, Index = idx, Pop = pp, Button = btn,
        Layout = layout, _icon = ic, _label = lb,
    })
    btn.MouseEnter:Connect(function() if W.Current ~= T then tween(ic, { ImageColor3 = C.Text }, 0.12) tween(lb, { TextColor3 = C.Text }, 0.12) end end)
    btn.MouseLeave:Connect(function() if W.Current ~= T then tween(ic, { ImageColor3 = C.Sub }, 0.18) tween(lb, { TextColor3 = C.Sub }, 0.18) end end)
    btn.MouseButton1Click:Connect(function() W:SelectTab(T) end)
