local warnedAcon = false
local function resolveIcon(name)
    if name == nil or name == false or name == "" then return nil end
    if type(name) == "number" then return "rbxassetid://" .. name end
    name = tostring(name)
    if name:find("^rbxasset") or name:find("^https?://") then return name end
    if tonumber(name) then return "rbxassetid://" .. name end
    local A = Lib.Acon or G.Acon
    if not A then
        if not warnedAcon then warnedAcon = true warn("[RofyUI] Acon が読み込まれていません (アイコンが出ません)") end
        return nil
    end
    local ok, res = pcall(A.Get, A, name)
    return ok and res or nil
end
-- 読み込みを待たずに置いて、取れたら絵を入れる (取れなければ fallbacks を順に試す)
local function setIcon(label, name, fallbacks)
    -- 正方形でない絵が引き伸ばされないように (アイコンごとに大きさがバラバラに見える原因)
    pcall(function() label.ScaleType = Enum.ScaleType.Fit end)
    task.spawn(function()
        local img = resolveIcon(name)
        if not img and fallbacks then
            for _, f in ipairs(fallbacks) do img = resolveIcon(f) if img then break end end
        end
        if label and label.Parent then label.Image = img or "" end
    end)
end

