local State = { Accent = Lib.Accents[1][2], AccentName = Lib.Accents[1][1], Glass = "Frosted" }
local AccentHooks = {}
local function accent() return State.Accent end
local function onAccent(fn) AccentHooks[#AccentHooks + 1] = fn fn(State.Accent) end

-- ガラスの種類 (tint = 地の色の透けぐあい / shade = 下の暗がり / sheen = 上のつや)
local GLASS = {
    Frosted = { tint = 0.14, shade = 0.55, sheen = 0.93 },
    Clear = { tint = 0.42, shade = 0.75, sheen = 0.88 },
    Dark = { tint = 0.02, shade = 0.7, sheen = 0.96 },
    Tint = { tint = 0.2, shade = 0.55, sheen = 0.92, colored = true },
}
Lib.GlassStyles = { "Frosted", "Clear", "Dark", "Tint" }

local Glasses = {}
local function applyGlassOne(o, instant)
    local g = GLASS[State.Glass] or GLASS.Frosted
    local t = instant and 0 or 0.5
    local col = g.colored and State.Accent:Lerp(BLACK, 0.74) or C.Base
    tween(o.tint, { BackgroundTransparency = g.tint, BackgroundColor3 = col }, t)
    tween(o.shade, { BackgroundTransparency = g.shade }, t)
    local gr = o.sheen:FindFirstChildOfClass("UIGradient")
    if gr then gr.Transparency = NumberSequence.new(g.sheen, 1) end
end
local function applyGlass() for o in pairs(Glasses) do applyGlassOne(o) end end

local function setAccent(a)
    if typeof(a) == "Color3" then
        State.Accent, State.AccentName = a, "Custom"
    elseif type(a) == "table" and a[1] then
        State.Accent, State.AccentName = Color3.new(a[1], a[2], a[3]), "Custom"
    elseif a ~= nil then
        for _, x in ipairs(Lib.Accents) do
            if string.lower(x[1]) == string.lower(tostring(a)) then State.Accent, State.AccentName = x[2], x[1] end
        end
    end
    for _, fn in ipairs(AccentHooks) do pcall(fn, State.Accent) end
    applyGlass()
end

-- すりガラス: 角を丸めた CanvasGroup に、地の色・下の暗がり・上のつや を重ねるだけ (静かで、うるさくない)
-- (中身の文字はこの外に置くので、にじまない)
local function glass(parent, radius, opts)
    opts = opts or {}
    local g = new("CanvasGroup", { Name = "Glass", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 0, Parent = parent })
    corner(g, radius)
    local tint = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.Base, BorderSizePixel = 0, ZIndex = 1, Parent = g })
    local shade = new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = BLACK, BorderSizePixel = 0, ZIndex = 3, Parent = g })
    new("UIGradient", { Transparency = NumberSequence.new(1, 0), Rotation = 90, Parent = shade })
    local sheen = new("Frame", { Size = UDim2.new(1, 0, 0, 90), BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 4, Parent = g })
    new("UIGradient", { Transparency = NumberSequence.new(0.9, 1), Rotation = 90, Parent = sheen })
    -- 縁の線は外側の枠に付けるので、外側も同じだけ角を丸める
    if not parent:FindFirstChildOfClass("UICorner") then corner(parent, radius) end
    local st = gstroke(parent, 0.8, 0.2, 0.9)
    local o = { group = g, tint = tint, shade = shade, sheen = sheen, stroke = st }
    Glasses[o] = true
    applyGlassOne(o, true)
    return o
end

-- 浮いた影: やわらかい影を重ねる (止める関数を返す)
local function softShadow(parent, radius, getAlpha)
    local layers = {}
    for i, l in ipairs({ { 8, 0.88 }, { 18, 0.93 }, { 34, 0.965 } }) do
        local f = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 6 + i * 3),
            Size = UDim2.new(1, l[1], 1, l[1]), BackgroundColor3 = BLACK, BackgroundTransparency = 1,
            BorderSizePixel = 0, ZIndex = 0, Parent = parent,
        })
        corner(f, radius + l[1] / 2)
        layers[i] = { f = f, base = l[2] }
    end
    return onStep(function()
        local a = clamp01(getAlpha())
        for _, l in ipairs(layers) do l.f.BackgroundTransparency = 1 - (1 - l.base) * a end
    end)
end

-- 開閉の演出: 動いている間だけ中身を CanvasGroup に入れてまとめて薄くする (止まったら外して文字をくっきり)
local function pop(holder, opts)
    opts = opts or {}
    local fader = new("CanvasGroup", { Name = "Fader", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, GroupTransparency = 1, Parent = holder })
    local body = new("Frame", { Name = "Body", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = fader })
    local sc = new("UIScale", { Parent = holder })
    local s = spring(0, opts.speed or 26, opts.damp or 0.88)
    local base = holder.Position
    local p = { holder = holder, body = body, spring = s, open = false, dy = opts.dy or 10, dx = opts.dx or 0 }
    function p:Set(open) self.open = open s.t = open and 1 or 0 end
    function p:Snap(open) self:Set(open) s.x, s.v = s.t, 0 end
    holder.Visible = false
    p.stop = onStep(function()
        local x = s.x
        local xc = clamp01(x)
        holder.Visible = xc > 0.004
        if not holder.Visible then return end
        local from = opts.from or 0.96
        sc.Scale = from + (1 - from) * x
        holder.Position = base + UDim2.fromOffset(p.dx * (1 - x), p.dy * (1 - x))
        if s.t == 1 and xc >= 0.999 then
            if body.Parent ~= holder then body.Parent = holder end
        else
            if body.Parent ~= fader then body.Parent = fader end
            fader.GroupTransparency = 1 - xc * xc * (3 - 2 * xc)
        end
    end)
    return p
end

-- ボタンのキレのある反応 (乗せると少し大きく、押すと縮む)
local PressedAt = 0
local function bounce(btn, target, hoverScale, speed, damp, downScale)
    target = target or btn
    local sc = target:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = target })
    local s = spring(1, speed or 28, damp or 0.88)
    local hover, down = false, false
    local function aim() s.t = down and (downScale or 0.95) or (hover and (hoverScale or 1.025) or 1) end
    btn.MouseEnter:Connect(function() hover = true aim() end)
    btn.MouseLeave:Connect(function() hover, down = false, false aim() end)
    btn.MouseButton1Down:Connect(function() down = true PressedAt = os.clock() aim() end)
    btn.MouseButton1Up:Connect(function() down = false aim() end)
    onStep(function() sc.Scale = s.x end)
    return s
end

-- ガラスのボタン (上の光沢と縁)
local function makeGlassButton(btn, isPrimary)
    corner(btn, UDim.new(1, 0))
    local st = stroke(btn, WHITE, isPrimary and 0.45 or 0.82, 1)
    new("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new(isPrimary and 0.1 or 0.4, 0.95),
        Parent = st,
    })
    if isPrimary then
        new("UIGradient", { Rotation = 90, Color = ColorSequence.new(WHITE, rgb(215, 215, 225)), Parent = btn })
        btn.MouseEnter:Connect(function() tween(st, { Transparency = 0.25 }, 0.15) end)
        btn.MouseLeave:Connect(function() tween(st, { Transparency = 0.45 }, 0.2) end)
    else
        btn.BackgroundColor3 = WHITE
        btn.BackgroundTransparency = 0.92
        btn.MouseEnter:Connect(function()
            tween(btn, { BackgroundTransparency = 0.84 }, 0.15)
            tween(st, { Transparency = 0.65 }, 0.15)
        end)
        btn.MouseLeave:Connect(function()
            tween(btn, { BackgroundTransparency = 0.92 }, 0.2)
            tween(st, { Transparency = 0.82 }, 0.2)
        end)
    end
    bounce(btn, nil, 1.025)
end

-- アイコンのボタン (乗せるとすりガラスの玉が出る)
local function iconButton(parent, name, size, props)
    local b = new("ImageButton", {
        Size = UDim2.fromOffset(size + 14, size + 14), BackgroundColor3 = WHITE, BackgroundTransparency = 1,
        Image = "", AutoButtonColor = false, Parent = parent,
    })
    corner(b, UDim.new(1, 0))
    local st = stroke(b, WHITE, 1, 1)
    local ic = new("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1, ImageColor3 = C.Sub, ZIndex = (props and props.ZIndex) or 1, Parent = b,
    })
    setIcon(ic, name)
    for k, v in pairs(props or {}) do b[k] = v end
    b.MouseEnter:Connect(function()
        tween(b, { BackgroundTransparency = 0.86 }, 0.12)
        tween(st, { Transparency = 0.8 }, 0.12)
        tween(ic, { ImageColor3 = C.Text }, 0.12)
    end)
    b.MouseLeave:Connect(function()
        tween(b, { BackgroundTransparency = 1 }, 0.18)
        tween(st, { Transparency = 1 }, 0.18)
        tween(ic, { ImageColor3 = C.Sub }, 0.18)
    end)
    bounce(b, nil, 1.06, 32, 0.86, 0.9)
    return b, ic
end

-- 押してから離すまで、位置を onMove(Vector2) に渡し続ける (スライダー・色)
local function track(hit, onMove, onEnd)
    local active = false
    hit.InputBegan:Connect(function(input)
        local t = input.UserInputType
        if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
            active = true
            PressedAt = os.clock()
            onMove(pointer(input))
        end
    end)
    conn(UserInputService.InputChanged:Connect(function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            onMove(pointer(input))
        end
    end))
    conn(UserInputService.InputEnded:Connect(function(input)
        if active and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
            active = false
            if onEnd then onEnd() end
        end
    end))
    return function() return active end
end

