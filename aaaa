-- ===================================================================
-- 小さな道具
-- ===================================================================
local function new(class, props, children)
    local o = Instance.new(class)
    local parent
    for k, v in pairs(props or {}) do
        if k == "Parent" then parent = v else o[k] = v end
    end
    for _, c in ipairs(children or {}) do c.Parent = o end
    if parent then o.Parent = parent end
    return o
end
local function corner(o, r) return new("UICorner", { CornerRadius = typeof(r) == "UDim" and r or UDim.new(0, r or 12), Parent = o }) end
local function stroke(o, color, tr, th)
    return new("UIStroke", {
        Color = color or WHITE, Transparency = tr or 0.9, Thickness = th or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = o,
    })
end
-- 上の縁だけかすかに光る線 (ガラスの縁)
local function gstroke(o, tr, a, b)
    local st = stroke(o, WHITE, tr or 0.84, 1)
    new("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(a or 0.45, b or 0.95), Parent = st })
    return st
end
local function text(props)
    local base = {
        BackgroundTransparency = 1, FontFace = F.Medium, TextColor3 = C.Text, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }
    for k, v in pairs(props) do base[k] = v end
    return new("TextLabel", base)
end
local function tween(o, props, t, style, dir)
    local tw = TweenService:Create(o, TweenInfo.new(t or 0.25, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), props)
    tw:Play()
    return tw
end
local function clamp01(x) return math.clamp(x, 0, 1) end
local function contrast(c)
    return (0.299 * c.R + 0.587 * c.G + 0.114 * c.B) > 0.68 and rgb(16, 16, 20) or WHITE
end
local function textHeight(str, size, width)
    local ok, v = pcall(TextService.GetTextSize, TextService, str, size, Enum.Font.GothamMedium, Vector2.new(width, 10000))
    return ok and v.Y or size + 4
end
local function call(fn, ...)
    if type(fn) ~= "function" then return end
    local args = table.pack(...)
    task.spawn(function()
        local ok, err = pcall(fn, table.unpack(args, 1, args.n))
        if not ok then warn("[RofyUI] callback error: " .. tostring(err)) end
    end)
end

-- マウス / 指の位置 (IgnoreGuiInset の画面と同じ座標)
local function pointer(input)
    if input and input.UserInputType == Enum.UserInputType.Touch then
        local inset = GuiService:GetGuiInset()
        return Vector2.new(input.Position.X + inset.X, input.Position.Y + inset.Y)
    end
    return UserInputService:GetMouseLocation()
end

-- バネ: 毎フレームまとめて進める (w = 速さ, z = 1 で行き過ぎない / 小さいほど弾む)
local Springs, Steps, PendingSteps = {}, {}, {}
local function spring(x, w, z)
    local s = { x = x, v = 0, t = x, w = w or 16, z = z or 1 }
    Springs[s] = true
    return s
end
local function unspring(s) Springs[s] = nil end
local function onStep(fn)
    PendingSteps[#PendingSteps + 1] = fn
    return function() Steps[fn] = nil for i, f in ipairs(PendingSteps) do if f == fn then table.remove(PendingSteps, i) break end end end
end
local Conns = {}
local function conn(c) Conns[#Conns + 1] = c return c end

conn(RunService.RenderStepped:Connect(function(dt)
    dt = math.min(dt, 1 / 20)
    for i = 1, #PendingSteps do Steps[PendingSteps[i]] = true end
    table.clear(PendingSteps)
    local n = math.max(1, math.ceil(dt * 120))
    local h = dt / n
    for s in pairs(Springs) do
        if s.x ~= s.t or s.v ~= 0 then
            for _ = 1, n do
                local a = s.w * s.w * (s.t - s.x) - 2 * s.z * s.w * s.v
                s.v = s.v + a * h
                s.x = s.x + s.v * h
            end
            if math.abs(s.t - s.x) < 1e-4 and math.abs(s.v) < 1e-3 then s.x, s.v = s.t, 0 end
        end
    end
    for fn in pairs(Steps) do
        local ok, err = pcall(fn, dt)
        if not ok then Steps[fn] = nil warn("[RofyUI] " .. tostring(err)) end
    end
end))

